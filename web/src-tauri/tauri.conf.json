{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proforna",
  "version": "0.0.1",
  "identifier": "dev.proforna.desktop",
  "build": {
    "beforeDevCommand": "node ../scripts/ensure-dev.mjs",
    "devUrl": "http://127.0.0.1:5173/",
    "beforeBuildCommand": "node ../scripts/prepare-desktop-resources.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "app",
        "title": "Proforna",
        "url": "http://127.0.0.1:5173/",
        "width": 1240,
        "height": 820,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": [
      "resources/node",
      "resources/server.mjs",
      "resources/web/**/*"
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
