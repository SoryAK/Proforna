generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model JobApplication {
  id          String   @id @default(uuid())
  company     String
  role        String
  url         String?
  location    String?
  type        String   @default("remote") // remote, hybrid, onsite
  status      String   @default("wishlist") // wishlist, applied, screening, interviewing, offer, accepted, rejected, withdrawn
  salaryMin   Int?
  salaryMax   Int?
  currency    String   @default("USD")
  appliedDate DateTime?
  notes       String?
  // Offer details (populated when status = offer/accepted)
  offerPayType      String?  // salary, hourly
  offerPayRate      String?  // e.g. "$35.50" for hourly
  offerSalary       Int?     // annual salary if salaried
  offerPayFrequency String?  // weekly, biweekly, semimonthly, monthly
  offerHoursPerWeek Float?
  offerOtHours      Float?
  offerOtRate       Float?   @default(1.5)
  offerSigningBonus Int?
  offerAnnualBonus  Int?     // expected annual bonus
  offerEquity       String?  // e.g. "5000 RSUs over 4 years"
  offer401kMatch    Float?   // employer match % (e.g. 6)
  offerPtoDays      Int?     // PTO days per year
  offerHealthCost   Float?   // monthly employee health insurance cost
  offerStartDate    DateTime?
  offerNotes        String?
  resumeVersionId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interviews Interview[]
  linkedEmails Email[]
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
}

model Interview {
  id              String   @id @default(uuid())
  jobApplicationId String
  type            String   @default("phone") // phone, technical, behavioral, onsite, panel
  scheduledAt     DateTime
  durationMinutes Int?     @default(60)
  location        String?
  interviewerName String?
  interviewerRole String?
  notes           String?
  status          String   @default("scheduled") // scheduled, completed, cancelled
  rating          Int?     // 1-5
  prepNotes       String?  // company research / prep notes
  questions       String?  // JSON array of questions to ask / expect
  reflection      String?  // post-interview reflection
  reflectionRating Int?    // 1-5 self-assessment
  createdAt       DateTime @default(now())

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
}

model Contact {
  id              String   @id @default(uuid())
  name            String
  email           String?
  phone           String?
  company         String?
  role            String?
  linkedinUrl     String?
  relationship    String   @default("other") // recruiter, referral, colleague, mentor, other
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime @default(now())
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  category    String   @default("technical") // technical, soft, language, tool
  proficiency String   @default("intermediate") // beginner, intermediate, advanced, expert
  createdAt   DateTime @default(now())
}

model Certification {
  id            String    @id @default(uuid())
  name          String
  issuer        String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialUrl String?
  createdAt     DateTime  @default(now())
}

model ResumeVersion {
  id            String   @id @default(uuid())
  name          String
  filePath      String?
  fileName      String?
  fileSize      Int?
  targetRole    String?
  notes         String?
  versionNumber Int      @default(1)
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())

  applications  JobApplication[]
}

model CareerGoal {
  id          String   @id @default(uuid())
  title       String
  description String?
  targetDate  DateTime?
  status      String   @default("not_started") // not_started, in_progress, completed, abandoned
  priority    String   @default("medium") // low, medium, high
  createdAt   DateTime @default(now())

  milestones Milestone[]
}

model Milestone {
  id           String    @id @default(uuid())
  careerGoalId String
  title        String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  careerGoal CareerGoal @relation(fields: [careerGoalId], references: [id], onDelete: Cascade)
}

model Reminder {
  id         String   @id @default(uuid())
  entityType String   // interview, goal, certification
  entityId   String
  title      String
  remindAt   DateTime
  isDismissed Boolean @default(false)
  snoozedUntil DateTime?
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(uuid())
  entityType  String   // application, interview, contact, skill, certification, resume, goal, document
  entityId    String
  action      String   // created, updated, status_changed, deleted
  description String
  metadata    String?  // optional JSON blob for extra context
  createdAt   DateTime @default(now())
}

model Document {
  id         String   @id @default(uuid())
  name       String
  fileName   String
  fileSize   Int
  mimeType   String
  data       String   // base64-encoded file content
  category   String   @default("other") // offer_letter, cover_letter, certificate, contract, pay_stub, tax_form, other
  entityType String?  // application, position, certification — what this doc relates to
  entityId   String?  // ID of the related entity
  notes      String?
  createdAt  DateTime @default(now())
}

model UserProfile {
  id                 String   @id @default(uuid())
  // Identity
  fullName           String?
  headline           String?  // e.g. "Senior Full-Stack Engineer"
  email              String?
  phone              String?
  avatarUrl          String?  // base64 data-url or file path
  city               String?
  state              String?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  // Career preferences
  availability       String   @default("open_to_work") // open_to_work, selectively_open, not_looking
  bio                String?
  preferredRoles     String?  // comma-separated
  targetSalaryMin    Int?
  targetSalaryMax    Int?
  currency           String   @default("USD")
  locationPreference String?  // e.g. "Remote, NYC, SF"
  showSkills         Boolean  @default(true)
  showResume         Boolean  @default(true)
  showCertifications Boolean  @default(true)
  showCurrentRole    Boolean  @default(true)
  portalSlug         String   @default("portal") @unique
  // Personal finance — portable across positions / job offers
  filingStatus       String   @default("single") // single, married_joint, married_separate, head_of_household
  federalTaxRate     Float?   // estimated federal tax %
  stateTaxRate       Float?   // estimated state tax %
  monthlyExpenses    String?  // JSON blob: { rent, utilities, car, insurance, phone, subscriptions, groceries, gas, studentLoans, creditCards, otherDebt, savings, otherExpenses }
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CurrentPosition {
  id            String    @id @default(uuid())
  company       String
  role          String
  department    String?
  location      String?
  type          String    @default("remote") // remote, hybrid, onsite
  startDate     DateTime
  endDate       DateTime?
  salary        Int?
  currency      String    @default("USD")
  description   String?
  responsibilities String? // comma-separated or newline-separated
  techStack     String?   // comma-separated
  managerName   String?
  isActive      Boolean   @default(true)
  // Company details
  companySynopsis String?
  industry      String?
  website       String?
  address       String?
  // Job details
  focus         String?   // primary job focus / summary
  schedule      String?   // e.g. "Overnight 6pm-6am | 3:4 day rotating week"
  payRate       String?   // base pay rate e.g. "$35.50"
  payType       String    @default("salary") // salary, hourly, contract
  differentials String?   // newline-separated e.g. "Night Shift +$2.00\nWeekend +$3.00"
  payFrequency  String    @default("biweekly") // weekly, biweekly, semimonthly, monthly
  rotatingSchedule Boolean @default(false)
  hoursPerWeek  Float?    // regular hours per week (schedule A if rotating)
  scheduleBHours Float?   // schedule B regular hours (only if rotatingSchedule)
  otHoursA      Float?    // OT hours per week for schedule A (or fixed schedule)
  otHoursB      Float?    // OT hours per week for schedule B (only if rotating)
  otRate        Float?    @default(1.5) // OT multiplier (e.g. 1.5x)
  annualRaiseMin Float?   // employer annual raise range minimum (e.g. 1 for 1%)
  annualRaiseMax Float?   // employer annual raise range maximum (e.g. 3 for 3%)
  estimatorSettings String? // JSON blob for estimator inputs (OT, tax rates, deductions, etc.)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  compensation CompensationEvent[]
  benefits     Benefit[]
  timeOff      TimeOffBalance[]
  paychecks    PaycheckRecord[]
  equipment    Equipment[]
  workLogs     WorkLog[]
}

model Equipment {
  id            String    @id @default(uuid())
  positionId    String
  name          String
  category      String    @default("hardware") // hardware, software, vehicle, safety, tool, other
  manufacturer  String?
  model         String?
  serialNumber  String?
  assetTag      String?
  assignedDate  DateTime?
  returnedDate  DateTime?
  condition     String    @default("good") // new, good, fair, poor
  licenseKey    String?
  version       String?
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  position  CurrentPosition   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  resources EquipmentResource[]
}

model EquipmentResource {
  id          String   @id @default(uuid())
  equipmentId String
  type        String   @default("manual") // manual, troubleshooting, operations, safety, maintenance, parts, training
  title       String
  content     String?  // text content (notes, procedures, tips)
  fileName    String?  // original file name if attachment
  fileData    Bytes?   // stored file data
  fileMime    String?  // MIME type
  url         String?  // external link
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model WorkLog {
  id             String   @id @default(uuid())
  positionId     String
  date           DateTime
  title          String
  content        String?  // detailed notes, what you did
  category       String   @default("task") // task, meeting, project, training, administrative, maintenance, on-call, other
  hours          Float?   // hours spent
  tags           String?  // comma-separated tags
  accomplishment Boolean  @default(false) // flag for performance review items
  impact         String?  // low, medium, high, critical
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  position CurrentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model CompensationEvent {
  id            String   @id @default(uuid())
  positionId    String
  type          String   @default("base_salary") // base_salary, bonus, equity, raise, promotion, signing_bonus, stipend, other
  title         String
  amount        Int
  currency      String   @default("USD")
  effectiveDate DateTime
  recurring     Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  position CurrentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model Benefit {
  id           String    @id @default(uuid())
  positionId   String
  category     String    @default("health") // health, dental, vision, retirement, insurance, wellness, education, other
  name         String
  provider     String?
  coverage     String?
  employerCost Int?
  employeeCost Int?
  notes        String?
  enrolledAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  position CurrentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model TimeOffBalance {
  id        String   @id @default(uuid())
  positionId String
  category  String   @default("pto") // pto, sick, personal, holiday, parental, bereavement, other
  totalDays Float    @default(0)
  usedDays  Float    @default(0)
  year      Int
  accrual   String   @default("annual") // annual, monthly, biweekly
  carryOver Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())

  entries  TimeOffEntry[]
  position CurrentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model TimeOffEntry {
  id        String   @id @default(uuid())
  balanceId String
  startDate DateTime
  endDate   DateTime
  days      Float    @default(1)
  status    String   @default("planned") // planned, approved, taken, cancelled
  reason    String?
  createdAt DateTime @default(now())

  balance TimeOffBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)
}

model RecruiterSubmission {
  id             String   @id @default(uuid())
  recruiterName  String
  recruiterEmail String
  company        String?
  linkedinUrl    String?
  jobTitle       String
  jobDescription String?
  salaryMin      Int?
  salaryMax      Int?
  location       String?
  jobType        String?  // remote, hybrid, onsite
  message        String?
  status         String   @default("new") // new, reviewed, archived
  contactId      String?  // auto-created Contact
  applicationId  String?  // auto-created Application
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Career Financial Model ──────────────────────────────────

model CareerIncomeYear {
  id          String   @id @default(uuid())
  year        Int      @unique
  grossIncome Float    // total gross earnings
  netIncome   Float?   // AGI / net after taxes
  jobCount    Int      @default(1) // number of jobs that year
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     CareerIncomeEntry[]
  w2Records   W2Record[]
}

model CareerIncomeEntry {
  id          String   @id @default(uuid())
  yearId      String
  employer    String               // company name from W-2 or manual entry
  grossIncome Float
  netIncome   Float?
  ein         String?              // employer EIN
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  incomeYear  CareerIncomeYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model W2Record {
  id                  String   @id @default(uuid())
  yearId              String
  taxYear             Int
  // Employer info
  employerName        String?
  employerEIN         String?
  employerAddress     String?
  state               String?
  // W-2 Box values
  wages               Float?   // Box 1
  federalTaxWithheld  Float?   // Box 2
  socialSecurityWages  Float?  // Box 3
  socialSecurityTax   Float?   // Box 4
  medicareWages       Float?   // Box 5
  medicareTax         Float?   // Box 6
  stateWages          Float?   // Box 16
  stateTaxWithheld    Float?   // Box 17
  localWages          Float?   // Box 18
  localTaxWithheld    Float?   // Box 19
  // Computed
  netIncome           Float?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  incomeYear          CareerIncomeYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model WageTier {
  id         String  @id @default(uuid())
  label      String  // e.g. "Short-Term", "Long-Term", "Target"
  hourlyRate Float
  yearlyRate Float
  sortOrder  Int     @default(0)
  color      String  @default("#6366f1") // UI accent color
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EmailAccount {
  id           String    @id @default(uuid())
  provider     String    // "google" | "microsoft"
  email        String
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  emails       Email[]

  @@unique([provider, email])
}

// ─── Interactive Resumes (Shareable Living Resumes) ────────────────

model InteractiveResume {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  targetRole    String?
  summary       String?
  theme         String   @default("modern")
  isPublished   Boolean  @default(false)
  sections      String?  // JSON: section visibility & ordering
  customContent String?  // JSON: per-section overrides
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  views         ResumeView[]
}

model ResumeView {
  id              String            @id @default(uuid())
  resumeId        String
  referrer        String?
  userAgent       String?
  sectionsViewed  String?           // JSON array of section keys
  durationSeconds Int?
  createdAt       DateTime          @default(now())
  resume          InteractiveResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

// ─── Paycheck Records (YTD tracking per position) ──────────────────

model PaycheckRecord {
  id              String    @id @default(uuid())
  positionId      String
  payPeriodStart  DateTime?
  payPeriodEnd    DateTime?
  grossPay        Float?
  netPay          Float?
  payRate         Float?
  regularHours    Float?
  overtimeHours   Float?
  // YTD totals from paycheck
  ytdGross        Float?
  ytdNet          Float?
  ytdFederalTax   Float?
  ytdStateTax     Float?
  ytdSocialSec    Float?
  ytdMedicare     Float?
  ytdRetirement   Float?
  ytdHealthIns    Float?
  ytdTotalDed     Float?
  // Tax percentages extracted
  taxPercentages  String?   // JSON blob: { federalTax, stateTax, socialSecurity, medicare, retirement, healthInsurance, totalDeductions }
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  position CurrentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model Email {
  id         String   @id @default(uuid())
  accountId  String
  messageId  String   // provider's unique message ID
  subject    String?
  sender     String   // from address
  recipient  String?  // to address
  date       DateTime
  snippet    String?  // short preview text
  body       String?  // full text body
  isRead     Boolean  @default(false)
  labels     String?  // comma-separated
  applicationId String?
  createdAt  DateTime @default(now())
  account    EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  application JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([accountId, messageId])
}

// ─── Career Directional Model (CDM) ────────────────────────────────

model CareerPath {
  id              String   @id @default(uuid())
  title           String                           // e.g. "Staff Engineer"
  description     String?
  targetRole      String?                          // role title to aim for
  targetSalaryMin Int?
  targetSalaryMax Int?
  industry        String?
  level           String   @default("mid")         // entry/mid/senior/lead/executive
  requiredSkills  String?                          // JSON: [{name, proficiency}]
  timelineYears   Int?                             // typical years to reach
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  milestones      CareerPathMilestone[]
  scores          DirectionScore[]
}

model CareerPathMilestone {
  id          String  @id @default(uuid())
  pathId      String
  title       String
  description String?
  sortOrder   Int     @default(0)
  isRequired  Boolean @default(false)
  path        CareerPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
}

model CareerSnapshot {
  id               String   @id @default(uuid())
  capturedAt       DateTime @default(now())
  totalSkills      Int      @default(0)
  avgProficiency   Float    @default(0)            // 0-100 scale
  incomeGross      Float?
  incomeNet        Float?
  activeGoals      Int      @default(0)
  completedGoals   Int      @default(0)
  certCount        Int      @default(0)
  applicationsOpen Int      @default(0)
  interviewsCount  Int      @default(0)
  currentRole      String?
  currentCompany   String?
  overallScore     Float?                          // computed composite 0-100
  metadata         String?                         // JSON: extra computed data
  scores           DirectionScore[]
}

model DirectionScore {
  id              String   @id @default(uuid())
  snapshotId      String
  pathId          String
  skillMatch      Float    @default(0)             // 0-100
  incomeAlignment Float    @default(0)             // 0-100
  goalAlignment   Float    @default(0)             // 0-100
  overallScore    Float    @default(0)             // 0-100 weighted composite
  gaps            String?                          // JSON: [{type, name, detail}]
  createdAt       DateTime @default(now())
  snapshot        CareerSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  path            CareerPath     @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, pathId])
}

// ── Learning Tracker ──────────────────────────────────
model LearningItem {
  id          String   @id @default(cuid())
  title       String
  provider    String?                          // Coursera, Udemy, O'Reilly, etc.
  type        String   @default("course")      // course | certification_prep | book | tutorial | workshop | bootcamp
  status      String   @default("not_started") // not_started | in_progress | completed | abandoned
  progress    Int      @default(0)             // 0-100
  url         String?
  hoursSpent  Float    @default(0)
  cost        Float    @default(0)
  completedAt DateTime?
  skills      String?                          // JSON: string[] of skill names this develops
  notes       String?
  tags        String?                          // JSON: string[] for categorization
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Industry Research (RSS Feeds) ─────────────────────
model ResearchFeed {
  id            String   @id @default(cuid())
  title         String
  url           String   @unique
  category      String   @default("general")   // industry | tech | general | finance | career
  isActive      Boolean  @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime @default(now())
  articles      ResearchArticle[]
}

model ResearchArticle {
  id          String   @id @default(cuid())
  feedId      String
  title       String
  url         String
  source      String?
  summary     String?
  publishedAt DateTime?
  imageUrl    String?
  isBookmarked Boolean  @default(false)
  isRead      Boolean  @default(false)
  tags        String?                          // JSON: string[]
  createdAt   DateTime @default(now())
  feed        ResearchFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
}

// ── Job Market Research (BLS) ─────────────────────────
model MarketSearch {
  id            String   @id @default(cuid())
  seriesId      String                         // BLS series code
  title         String
  occupation    String?
  area          String?
  dataType      String   @default("wages")     // wages | employment | projections
  lastData      String?                        // JSON: cached BLS response
  lastFetchedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
