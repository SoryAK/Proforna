generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js v5 Models ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed — only for credentials auth
  ingestToken   String?   @unique  // unique token for email forwarding webhook
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  // ── App data relations ──
  profile             UserProfile?
  applications        JobApplication[]
  interviews          Interview[]
  contacts            Contact[]
  skills              Skill[]
  certifications      Certification[]
  resumeVersions      ResumeVersion[]
  goals               CareerGoal[]
  reminders           Reminder[]
  activityLogs        ActivityLog[]
  documents           Document[]
  submissions         RecruiterSubmission[]
  incomeYears         CareerIncomeYear[]
  wageTiers           WageTier[]
  emailAccounts       EmailAccount[]
  interactiveResumes  InteractiveResume[]
  careerPaths         CareerPath[]
  careerSnapshots     CareerSnapshot[]
  learningItems       LearningItem[]
  learningTopics      LearningTopic[]
  studySessions       StudySession[]
  researchFeeds       ResearchFeed[]
  marketSearches      MarketSearch[]
  companyProfiles     CompanyProfile[]
  interestGroups      InterestGroup[]
  interestGroupItems  InterestGroupItem[]
  jobPostings         JobPosting[]
  lifeAnchors         LifeAnchor[]
  emailLeads          EmailLead[]
  workHistory         WorkHistory[]
  recruiterFlags      RecruiterFlag[]
  addressOverrides    AddressOverride[]
  companyWatchlist    CompanyWatchlist[]
  decompositionTrees DecompositionTree[]
  titleSynonymClusters TitleSynonymCluster[]
  savedSearches       SavedSearch[]
  skillNodes          SkillNode[]
  skillEvidence       SkillEvidence[]
  scaffoldMeta        ScaffoldMeta[]
  occupations         Occupation[]
  occupationInterests UserOccupationInterest[]
  mapDrawingLayers    MapDrawingLayer[]
  mapDrawings         MapDrawing[]
  residences          Residence[]
  diffusionExposures  DiffusionExposure[]
  careerEvents        CareerEvent[]
  employerAliases     EmployerAlias[]
  personalEquipment   PersonalEquipment[]
  publishedProfile    PublishedProfile?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Job Search & Applications ─────────────────────────────────

model JobApplication {
  id          String   @id @default(uuid())
  userId      String
  company     String
  role        String
  url         String?
  location    String?
  type        String   @default("remote")
  status      String   @default("wishlist")
  salaryMin   Int?
  salaryMax   Int?
  currency    String   @default("USD")
  appliedDate DateTime?
  notes       String?
  offerPayType      String?
  offerPayRate      String?
  offerSalary       Int?
  offerPayFrequency String?
  offerHoursPerWeek Float?
  offerOtHours      Float?
  offerOtRate       Float?   @default(1.5)
  offerSigningBonus Int?
  offerAnnualBonus  Int?
  offerEquity       String?
  offer401kMatch    Float?
  offerPtoDays      Int?
  offerHealthCost   Float?
  offerStartDate    DateTime?
  offerNotes        String?
  ein             String?
  resumeVersionId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  linkedEmails  Email[]
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
}

model Interview {
  id              String   @id @default(uuid())
  userId          String
  jobApplicationId String
  type            String   @default("phone")
  scheduledAt     DateTime
  durationMinutes Int?     @default(60)
  location        String?
  interviewerName String?
  interviewerRole String?
  notes           String?
  status          String   @default("scheduled")
  rating          Int?
  prepNotes       String?
  questions       String?
  reflection      String?
  reflectionRating Int?
  createdAt       DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
}

model Contact {
  id              String   @id @default(uuid())
  userId          String
  name            String
  email           String?
  phone           String?
  company         String?
  role            String?
  linkedinUrl     String?
  relationship    String   @default("other")
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecruiterSubmission {
  id             String   @id @default(uuid())
  userId         String
  recruiterName  String
  recruiterEmail String
  recruiterPhone String?
  company        String?
  linkedinUrl    String?
  jobTitle       String
  jobDescription String?
  salaryMin      Int?
  salaryMax      Int?
  location       String?
  jobType        String?
  message        String?
  joinNetwork    Boolean  @default(false)
  // Recruit Mode metadata captured at submission time
  jobLat         Float?
  jobLng         Float?
  commuteMiles   Float?
  commuteMinutes Int?
  withinRange    Boolean?
  status         String   @default("new")
  contactId      String?
  applicationId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Skills & Learning ─────────────────────────────────────────

model Skill {
  id          String   @id @default(uuid())
  userId      String
  name        String
  category    String   @default("technical")
  proficiency String   @default("intermediate")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certification {
  id            String    @id @default(uuid())
  userId        String
  name          String
  issuer        String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialUrl String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningItem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  provider    String?
  type        String   @default("course")
  status      String   @default("not_started")
  progress    Int      @default(0)
  url         String?
  hoursSpent  Float    @default(0)
  cost        Float    @default(0)
  completedAt DateTime?
  skills      String?
  notes       String?
  tags        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Resume & Portfolio ────────────────────────────────────────

model ResumeVersion {
  id            String   @id @default(uuid())
  userId        String
  name          String
  filePath      String?
  fileName      String?
  fileSize      Int?
  targetRole    String?
  notes         String?
  versionNumber Int      @default(1)
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]
}

model InteractiveResume {
  id            String   @id @default(uuid())
  userId        String
  slug          String   @unique
  title         String
  targetRole    String?
  summary       String?
  theme         String   @default("modern")
  isPublished   Boolean  @default(false)
  sections      String?
  customContent String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  views ResumeView[]
}

model ResumeView {
  id              String            @id @default(uuid())
  resumeId        String
  referrer        String?
  userAgent       String?
  sectionsViewed  String?
  durationSeconds Int?
  createdAt       DateTime          @default(now())

  resume InteractiveResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

// ─── IR Engagement Analytics ───────────────────────────────────
// Granular engagement events for the adaptive Interactive Resume.
// Keyed by irSlug (works for both UserProfile.irSlug and legacy IR slugs).
// Anonymous viewers are identified by a long-lived cookie sessionId.
model IrViewEvent {
  id              String   @id @default(uuid())
  irSlug          String
  sessionId       String                          // anonymous-cookie viewer session id
  accessRequestId String?                         // set when viewer used an approved access token
  eventType       String                          // view | role_click | contact_open | contact_method_click | education_click | journey_play | session_heartbeat
  eventData       String?                         // JSON blob of extra context (workItemId, method, etc.)
  referrer        String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([irSlug, createdAt])
  @@index([irSlug, sessionId])
  @@index([irSlug, eventType])
}

// Recruiter-side bookmarks of candidate IRs, keyed by an anonymous
// long-lived `recruiter_id` cookie (no account required).
model RecruiterSavedCandidate {
  id          String    @id @default(uuid())
  viewerKey   String                                  // recruiter_id cookie
  irSlug      String
  candidateName String?                               // snapshot at save-time for display
  candidateHeadline String?
  tag         String?                                 // hot | maybe | no_go | null
  savedAt     DateTime  @default(now())
  archivedAt  DateTime?

  @@unique([viewerKey, irSlug])
  @@index([viewerKey, savedAt])
  @@index([viewerKey, tag])
  @@index([irSlug])
}

// Recruiter private notes about a candidate IR, keyed by recruiter cookie.
model RecruiterNote {
  id        String   @id @default(uuid())
  viewerKey String                                    // recruiter_id cookie
  irSlug    String
  body      String                                    // free-form recruiter note
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([viewerKey, irSlug])
  @@index([viewerKey, updatedAt])
}

// ─── Profile & Identity ────────────────────────────────────────

model UserProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  fullName           String?
  headline           String?
  email              String?
  phone              String?
  avatarUrl          String?
  city               String?
  state              String?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  schedulingUrl      String?   // Calendly/Cal.com/etc — used for "Schedule an interview" CTA
  contactCtaMessage  String?   // Custom message/disclosure shown atop the "Get in touch" modal
  availability       String   @default("open_to_work")
  bio                String?
  preferredRoles     String?
  targetSalaryMin    Int?
  targetSalaryMax    Int?
  currency           String   @default("USD")
  locationPreference String?
  industryGroup      String?  // SOC major group, e.g. "Computer and Mathematical" — powers scaffold suggestions
  showSkills         Boolean  @default(true)
  showResume         Boolean  @default(true)
  showCertifications Boolean  @default(true)
  showCurrentRole    Boolean  @default(true)
  portalSlug         String   @default("portal") @unique

  // ── Adaptive Interactive Resume (IR) ──
  // The IR is a single, profile-driven page at /r/<irSlug>.
  // bio is the canonical summary; irSections controls section visibility/order.
  irSlug             String?  @unique
  irTheme            String   @default("modern")
  irSections         String?                          // JSON: [{type,visible,order,settings?}]
  irTargetRole       String?                          // optional default headline override for the IR

  filingStatus       String   @default("single")
  federalTaxRate     Float?
  stateTaxRate       Float?
  monthlyExpenses    String?

  // ── Stealth Mode / Privacy ──
  visibility         String   @default("public")   // public | stealth | anonymous | private
  hideCurrentEmployer Boolean @default(false)
  anonymousTitle     String?                        // e.g. "Verified Electro-Mechanical Specialist #842"
  blockedEins        String?                        // JSON array of EINs to block
  blockedDomains     String?                        // JSON array of email domains to block

  // ── Home Address ──
  homeAddress        String?
  homeLat            Float?
  homeLng            Float?
  maxCommuteMiles    Int?     // Max one-way distance owner is willing to commute (used by IR Recruit Mode)

  // ── Vehicle / Commute ──
  vehicleYear        String?
  vehicleMake        String?
  vehicleModel       String?
  vehicleId          String?                        // FuelEconomy.gov vehicle ID
  vehicleMpg         Float?
  gasPricePerGallon  Float?
  daysInOffice       Int?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessRequests AccessRequest[]
  singleUseLinks SingleUseLink[]
  compensation   CompensationPreference?
}

// ─── Published Profile Snapshot ────────────────────────────────
// Frozen copy of the user's IR-facing data (profile + compensation +
// work history). The public IR endpoint reads from this — edits to
// UserProfile/CompensationPreference/WorkHistory don't go live until
// the user explicitly publishes from the work-mapping panel.
model PublishedProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  // Snapshot of UserProfile fields shown on the IR
  profileSnapshot Json
  // Snapshot of CompensationPreference (sanitized — no hardFloor)
  compensationSnapshot Json?
  // Snapshot of WorkHistory[] with relations (galleryPhotos, attachments, equipment)
  workHistorySnapshot Json?
  publishedAt     DateTime @default(now())
  // Free-form note the user can attach to a publish ("updated headline", etc.)
  publishNote     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Compensation Expectations ─────────────────────────────────
// Candidate-set pay requirements surfaced on the IR so recruiters can
// self-filter before reaching out. 1:1 with UserProfile.
model CompensationPreference {
  id                String   @id @default(uuid())
  profileId         String   @unique
  // Public range
  period            String   @default("annual")   // annual | hourly | monthly
  currency          String   @default("USD")
  salaryMin         Int?
  salaryTarget      Int?
  salaryMax         Int?
  // Private hard floor — exact number is never sent to recruiters,
  // but we surface a "below candidate's minimum" badge if a comparison number is provided.
  hardFloor         Int?
  // Employment type preferences (JSON string array): full_time | part_time | contract | 1099 | internship | temp
  employmentTypes   String?
  // Openness flags
  openToRelocation  Boolean  @default(false)
  openToEquity      Boolean  @default(false)
  openToBonus       Boolean  @default(true)
  openToSignOn      Boolean  @default(false)
  remotePreference  String   @default("any")      // any | remote | hybrid | onsite
  // Benefits must-haves (JSON string array): e.g. ["health","401k_match","unlimited_pto"]
  benefitsMustHaves String?
  notes             String?
  // Visibility on the IR: public | recruiters | hidden
  visibility        String   @default("public")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Stealth Mode: Access Requests ─────────────────────────────

model AccessRequest {
  id            String    @id @default(uuid())
  profileId     String
  requesterName String
  requesterEmail String
  requesterCompany String?
  requesterLinkedin String?
  message       String?
  status        String    @default("pending")  // pending | approved | denied
  approvedAt    DateTime?
  accessToken   String?   @unique              // magic link token for approved access
  tokenExpiresAt DateTime?
  // ── Per-share IR overrides (shown only to viewers using this token) ──
  targetRole    String?                            // override the default headline for this viewer
  focusSections String?                            // JSON array of section types to highlight
  createdAt     DateTime  @default(now())

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Stealth Mode: Single-Use Links ────────────────────────────

model SingleUseLink {
  id          String    @id @default(uuid())
  profileId   String
  token       String    @unique
  label       String?                           // e.g. "For Recruiter at ABB"
  viewedAt    DateTime?
  viewedBy    String?                           // IP or user-agent of viewer
  expiresAt   DateTime
  // ── Per-share IR overrides ──
  targetRole    String?                          // override headline for this viewer
  focusSections String?                          // JSON array of section types to highlight
  createdAt   DateTime  @default(now())

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Equipment & Work Logs ─────────────────────────────────────

model Equipment {
  id            String    @id @default(uuid())
  positionId    String
  name          String
  category      String    @default("hardware")
  usage         String    @default("used")     // "used" = assigned to you | "worked-on" = you maintained/operated
  manufacturer  String?
  model         String?
  serialNumber  String?
  assetTag      String?
  assignedDate  DateTime?
  returnedDate  DateTime?
  condition     String    @default("good")
  licenseKey    String?
  version       String?
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  position  WorkHistory   @relation("WorkHistoryEquipment", fields: [positionId], references: [id], onDelete: Cascade)
  resources EquipmentResource[]
  photos    EquipmentPhoto[]
}

model EquipmentPhoto {
  id          String   @id @default(uuid())
  equipmentId String
  filePath    String
  fileName    String
  fileMime    String
  fileSize    Int
  caption     String?
  isCover     Boolean  @default(false)
  createdAt   DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

model EquipmentResource {
  id          String   @id @default(uuid())
  equipmentId String
  type        String   @default("manual")
  title       String
  content     String?
  fileName    String?
  fileData    Bytes?
  fileMime    String?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

// ─── Personal Inventory (user-scoped, not tied to a job) ───────

model PersonalEquipment {
  id            String    @id @default(uuid())
  userId        String
  name          String
  category      String    @default("tool")        // hardware | software | vehicle | safety | tool | instrument | other
  ownership     String    @default("personal")    // personal | shared | borrowed | rental
  manufacturer  String?
  model         String?
  serialNumber  String?
  condition     String    @default("good")        // new | good | fair | poor
  proficiency   Int?                              // 1-5 self-rated
  purchaseDate  DateTime?
  purchasePrice Float?
  currentValue  Float?
  location      String?                           // where it's stored
  isPrivate     Boolean   @default(true)          // hide from public IR by default
  isDraft       Boolean   @default(false)         // true when created via bulk-photo upload, awaiting details
  notes         String?
  tags          String[]  @default([])             // free-text user tags
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos PersonalEquipmentPhoto[]

  @@index([userId])
}

model PersonalEquipmentPhoto {
  id          String   @id @default(uuid())
  equipmentId String
  filePath    String
  fileName    String
  fileMime    String
  fileSize    Int
  caption     String?
  isCover     Boolean  @default(false)
  sortOrder   Int      @default(0)
  focalX      Int      @default(50) // 0-100, horizontal focal point %
  focalY      Int      @default(50) // 0-100, vertical focal point %
  zoom        Float    @default(1)  // 1.0 = cover (no extra zoom)
  createdAt   DateTime @default(now())

  equipment PersonalEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

model WorkLog {
  id             String   @id @default(uuid())
  positionId     String
  date           DateTime
  title          String
  content        String?
  category       String   @default("task")
  hours          Float?
  tags           String?
  accomplishment Boolean  @default(false)
  impact         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  position WorkHistory @relation("WorkHistoryWorkLogs", fields: [positionId], references: [id], onDelete: Cascade)
}

// ─── Attachments (files linked to a work history entry) ────────

model Attachment {
  id          String   @id @default(uuid())
  positionId  String
  label       String                         // user-facing name, e.g. "Offer Letter"
  category    String   @default("other")     // "offer-letter" | "w2" | "pay-stub" | "contract" | "cert" | "review" | "other"
  fileName    String                         // original file name
  filePath    String                         // server path under /uploads/attachments/
  fileMime    String                         // e.g. "application/pdf"
  fileSize    Int                            // bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  position WorkHistory @relation("WorkHistoryAttachments", fields: [positionId], references: [id], onDelete: Cascade)
}

// ─── Gallery Photos (multiple photos per work history entry) ───

model GalleryPhoto {
  id            String    @id @default(uuid())
  workHistoryId String
  albumId       String?
  filePath      String    // /uploads/gallery/xxx.jpg
  fileName      String    // original file name
  fileMime      String    // image/jpeg etc
  fileSize      Int       // bytes
  caption       String?   // optional caption
  isCover       Boolean   @default(false)
  isFavorite    Boolean   @default(false)
  isPrivate     Boolean   @default(false)
  annotationsPublic Boolean @default(true) // when photo is shared, also expose annotations
  tags          String?   // JSON array of tag strings, e.g. ["welding","safety"]
  markers       String?   // legacy JSON pins (kept for back-compat); new feature uses MediaAnnotation
  dateTaken     DateTime?
  rotation      Int       @default(0)  // 0, 90, 180, 270 — display rotation (non-destructive)
  sortOrder     Int?
  createdAt     DateTime  @default(now())

  workHistory WorkHistory @relation("WorkHistoryGallery", fields: [workHistoryId], references: [id], onDelete: Cascade)
  album       GalleryAlbum? @relation("GalleryAlbumPhotos", fields: [albumId], references: [id], onDelete: SetNull)
  annotations MediaAnnotation[] @relation("GalleryPhotoAnnotations")

  @@index([workHistoryId])
  @@index([albumId])
}

model GalleryAlbum {
  id            String    @id @default(uuid())
  workHistoryId String
  name          String
  sortOrder     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workHistory WorkHistory   @relation("WorkHistoryGalleryAlbums", fields: [workHistoryId], references: [id], onDelete: Cascade)
  photos      GalleryPhoto[] @relation("GalleryAlbumPhotos")

  @@index([workHistoryId])
  @@unique([workHistoryId, name])
}

// ─── Media Annotations (rich shapes + notes on photos/videos) ──

model MediaAnnotation {
  id              String   @id @default(uuid())
  photoId         String?
  // videoId String? — reserved for future GalleryVideo support
  kind            String   // "pin" | "rect" | "circle" | "arrow" | "freehand"
  geometry        String   // JSON; coords normalized 0..1 relative to media
  title           String?
  body            String?  // rich-text HTML (tiptap output)
  color           String   @default("#ef4444")
  tags            String?  // JSON array of tag strings
  sortOrder       Int?     // null = not part of tour; numeric = step in tour
  videoTimestamp  Float?   // seconds; null for photos or persistent video annotations
  isPrivate       Boolean  @default(false) // override: hide on public surfaces even if photo is public
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  photo GalleryPhoto? @relation("GalleryPhotoAnnotations", fields: [photoId], references: [id], onDelete: Cascade)
  comments MediaAnnotationComment[] @relation("AnnotationComments")

  @@index([photoId])
  @@index([photoId, sortOrder])
}

model MediaAnnotationComment {
  id           String   @id @default(uuid())
  annotationId String
  authorId     String   // user id of comment author
  body         String   // plain text or simple markdown
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  annotation MediaAnnotation @relation("AnnotationComments", fields: [annotationId], references: [id], onDelete: Cascade)

  @@index([annotationId])
  @@index([annotationId, createdAt])
}

// ─── Compensation & Benefits ───────────────────────────────────

model CompensationEvent {
  id            String   @id @default(uuid())
  positionId    String
  type          String   @default("base_salary")
  title         String
  amount        Int
  currency      String   @default("USD")
  effectiveDate DateTime
  recurring     Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  position WorkHistory @relation("WorkHistoryCompensation", fields: [positionId], references: [id], onDelete: Cascade)
}

model Benefit {
  id           String    @id @default(uuid())
  positionId   String
  category     String    @default("health")
