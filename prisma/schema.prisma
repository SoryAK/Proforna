  ytdNet          Float?
  ytdFederalTax   Float?
  ytdStateTax     Float?
  ytdSocialSec    Float?
  ytdMedicare     Float?
  ytdRetirement   Float?
  ytdHealthIns    Float?
  ytdTotalDed     Float?
  taxPercentages  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

