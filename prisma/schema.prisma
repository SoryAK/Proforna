generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js v5 Models ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed — only for credentials auth
  ingestToken   String?   @unique // unique token for email forwarding webhook
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  // ── App data relations ──
  profile                 UserProfile?
  applications            JobApplication[]
  interviews              Interview[]
  contacts                Contact[]
  skills                  Skill[]
  certifications          Certification[]
  resumeVersions          ResumeVersion[]
  goals                   CareerGoal[]
  reminders               Reminder[]
  activityLogs            ActivityLog[]
  documents               Document[]
  documentFolders         DocumentFolder[]
  submissions             RecruiterSubmission[]
  incomeYears             CareerIncomeYear[]
  wageTiers               WageTier[]
  emailAccounts           EmailAccount[]
  interactiveResumes      InteractiveResume[]
  careerPaths             CareerPath[]
  careerSnapshots         CareerSnapshot[]
  learningItems           LearningItem[]
  learningTopics          LearningTopic[]
  studySessions           StudySession[]
  researchFeeds           ResearchFeed[]
  marketSearches          MarketSearch[]
  companyProfiles         CompanyProfile[]
  interestGroups          InterestGroup[]
  interestGroupItems      InterestGroupItem[]
  jobPostings             JobPosting[]
  lifeAnchors             LifeAnchor[]
  emailLeads              EmailLead[]
  workHistory             WorkHistory[]
  recruiterFlags          RecruiterFlag[]
  addressOverrides        AddressOverride[]
  companyWatchlist        CompanyWatchlist[]
  decompositionTrees      DecompositionTree[]
  titleSynonymClusters    TitleSynonymCluster[]
  savedSearches           SavedSearch[]
  skillNodes              SkillNode[]
  skillEvidence           SkillEvidence[]
  scaffoldMeta            ScaffoldMeta[]
  occupations             Occupation[]
  occupationInterests     UserOccupationInterest[]
  mapDrawingLayers        MapDrawingLayer[]
  mapDrawings             MapDrawing[]
  residences              Residence[]
  diffusionExposures      DiffusionExposure[]
  careerEvents            CareerEvent[]
  employerAliases         EmployerAlias[]
  personalEquipment       PersonalEquipment[]
  personalEquipmentShares PersonalEquipmentShare[]
  equipmentKits           EquipmentKit[]
  workLogs                WorkLog[]
  workLogImports          WorkLogImport[]
  workLogFolders          WorkLogFolder[]
  workLogCategories       WorkLogCategory[]
  workHistoryShifts       WorkHistoryShift[]
  workLogDrafts           WorkLogDraft[]
  workLogVersions         WorkLogVersion[]
  workLogTemplates        WorkLogTemplate[]
  workLogPreference       WorkLogPreference?
  integrationConnections  IntegrationConnection[]
  jobAssets               JobAsset[]
  assetTypes              AssetType[]
  publishedProfile        PublishedProfile?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Job Search & Applications ─────────────────────────────────

model JobApplication {
  id                String    @id @default(uuid())
  userId            String
  company           String
  role              String
  url               String?
  location          String?
  type              String    @default("remote")
  status            String    @default("wishlist")
  salaryMin         Int?
  salaryMax         Int?
  currency          String    @default("USD")
  appliedDate       DateTime?
  notes             String?
  offerPayType      String?
  offerPayRate      String?
  offerSalary       Int?
  offerPayFrequency String?
  offerHoursPerWeek Float?
  offerOtHours      Float?
  offerOtRate       Float?    @default(1.5)
  offerSigningBonus Int?
  offerAnnualBonus  Int?
  offerEquity       String?
  offer401kMatch    Float?
  offerPtoDays      Int?
  offerHealthCost   Float?
  offerStartDate    DateTime?
  offerNotes        String?
  ein               String?
  resumeVersionId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  linkedEmails  Email[]
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
}

model Interview {
  id               String   @id @default(uuid())
  userId           String
  jobApplicationId String
  type             String   @default("phone")
  scheduledAt      DateTime
  durationMinutes  Int?     @default(60)
  location         String?
  interviewerName  String?
  interviewerRole  String?
  notes            String?
  status           String   @default("scheduled")
  rating           Int?
  prepNotes        String?
  questions        String?
  reflection       String?
  reflectionRating Int?
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
}

model Contact {
  id              String    @id @default(uuid())
  userId          String
  name            String
  email           String?
  phone           String?
  company         String?
  role            String?
  linkedinUrl     String?
  relationship    String    @default("other")
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecruiterSubmission {
  id             String   @id @default(uuid())
  userId         String
  recruiterName  String
  recruiterEmail String
  recruiterPhone String?
  company        String?
  linkedinUrl    String?
  jobTitle       String
  jobDescription String?
  salaryMin      Int?
  salaryMax      Int?
  location       String?
  jobType        String?
  message        String?
  joinNetwork    Boolean  @default(false)
  // Recruit Mode metadata captured at submission time
  jobLat         Float?
  jobLng         Float?
  commuteMiles   Float?
  commuteMinutes Int?
  withinRange    Boolean?
  status         String   @default("new")
  contactId      String?
  applicationId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Skills & Learning ─────────────────────────────────────────

model Skill {
  id          String   @id @default(uuid())
  userId      String
  name        String
  category    String   @default("technical")
  proficiency String   @default("intermediate")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certification {
  id            String    @id @default(uuid())
  userId        String
  name          String
  issuer        String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialUrl String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningItem {
  id          String    @id @default(cuid())
  userId      String
  title       String
  provider    String?
  type        String    @default("course")
  status      String    @default("not_started")
  progress    Int       @default(0)
  url         String?
  hoursSpent  Float     @default(0)
  cost        Float     @default(0)
  completedAt DateTime?
  skills      String?
  notes       String?
  tags        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Resume & Portfolio ────────────────────────────────────────

model ResumeVersion {
  id            String   @id @default(uuid())
  userId        String
  name          String
  filePath      String?
  fileName      String?
  fileSize      Int?
  targetRole    String?
  notes         String?
  versionNumber Int      @default(1)
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]
}

model InteractiveResume {
  id            String   @id @default(uuid())
  userId        String
  slug          String   @unique
  title         String
  targetRole    String?
  summary       String?
  theme         String   @default("modern")
  isPublished   Boolean  @default(false)
  sections      String?
  customContent String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  views ResumeView[]
}

model ResumeView {
  id              String   @id @default(uuid())
  resumeId        String
  referrer        String?
  userAgent       String?
  sectionsViewed  String?
  durationSeconds Int?
  createdAt       DateTime @default(now())

  resume InteractiveResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

// ─── IR Engagement Analytics ───────────────────────────────────
// Granular engagement events for the adaptive Interactive Resume.
// Keyed by irSlug (works for both UserProfile.irSlug and legacy IR slugs).
// Anonymous viewers are identified by a long-lived cookie sessionId.
model IrViewEvent {
  id              String   @id @default(uuid())
  irSlug          String
  sessionId       String // anonymous-cookie viewer session id
  accessRequestId String? // set when viewer used an approved access token
  eventType       String // view | role_click | contact_open | contact_method_click | education_click | journey_play | session_heartbeat
  eventData       String? // JSON blob of extra context (workItemId, method, etc.)
  referrer        String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([irSlug, createdAt])
  @@index([irSlug, sessionId])
  @@index([irSlug, eventType])
}

// Recruiter-side bookmarks of candidate IRs, keyed by an anonymous
// long-lived `recruiter_id` cookie (no account required).
model RecruiterSavedCandidate {
  id                String    @id @default(uuid())
  viewerKey         String // recruiter_id cookie
  irSlug            String
  candidateName     String? // snapshot at save-time for display
  candidateHeadline String?
  tag               String? // hot | maybe | no_go | null
  savedAt           DateTime  @default(now())
  archivedAt        DateTime?

  @@unique([viewerKey, irSlug])
  @@index([viewerKey, savedAt])
  @@index([viewerKey, tag])
  @@index([irSlug])
}

// Recruiter private notes about a candidate IR, keyed by recruiter cookie.
model RecruiterNote {
  id        String   @id @default(uuid())
  viewerKey String // recruiter_id cookie
  irSlug    String
  body      String // free-form recruiter note
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([viewerKey, irSlug])
  @@index([viewerKey, updatedAt])
}

// ─── Profile & Identity ────────────────────────────────────────

model UserProfile {
  id                 String  @id @default(uuid())
  userId             String  @unique
  fullName           String?
  headline           String?
  email              String?
  phone              String?
  avatarUrl          String?
  city               String?
  state              String?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  schedulingUrl      String? // Calendly/Cal.com/etc — used for "Schedule an interview" CTA
  contactCtaMessage  String? // Custom message/disclosure shown atop the "Get in touch" modal
  availability       String  @default("open_to_work")
  bio                String?
  preferredRoles     String?
  targetSalaryMin    Int?
  targetSalaryMax    Int?
  salaryPeriod       String  @default("annual")
  currency           String  @default("USD")
  locationPreference String?
  industryGroup      String? // SOC major group, e.g. "Computer and Mathematical" — powers scaffold suggestions
  showSkills         Boolean @default(true)
  showResume         Boolean @default(true)
  showCertifications Boolean @default(true)
  showCurrentRole    Boolean @default(true)
  portalSlug         String  @unique @default("portal")

  // ── Adaptive Interactive Resume (IR) ──
  // The IR is a single, profile-driven page at /r/<irSlug>.
  // bio is the canonical summary; irSections controls section visibility/order.
  irSlug       String? @unique
  irTheme      String  @default("modern")
  irSections   String? // JSON: [{type,visible,order,settings?}]
  irTargetRole String? // optional default headline override for the IR

  filingStatus    String  @default("single")
  federalTaxRate  Float?
  stateTaxRate    Float?
  monthlyExpenses String?

  // ── Stealth Mode / Privacy ──
  visibility          String  @default("public") // public | stealth | anonymous | private
  hideCurrentEmployer Boolean @default(false)
  anonymousTitle      String? // e.g. "Verified Electro-Mechanical Specialist #842"
  blockedEins         String? // JSON array of EINs to block
  blockedDomains      String? // JSON array of email domains to block

  // ── Home Address ──
  homeAddress     String?
  homeLat         Float?
  homeLng         Float?
  maxCommuteMiles Int? // Max one-way distance owner is willing to commute (used by IR Recruit Mode)

  // ── Vehicle / Commute ──
  vehicleYear       String?
  vehicleMake       String?
  vehicleModel      String?
  vehicleId         String? // FuelEconomy.gov vehicle ID
  vehicleMpg        Float?
  gasPricePerGallon Float?
  daysInOffice      Int?

  // ── Display / UX preferences ──
  // Global default for whether the focused-job banner cycles through gallery photos.
  // Per-job overrides live on WorkHistory.bannerSlideshowOverride.
  bannerSlideshowEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessRequests AccessRequest[]
  singleUseLinks SingleUseLink[]
  compensation   CompensationPreference?
}

// ─── Published Profile Snapshot ────────────────────────────────
// Frozen copy of the user's IR-facing data (profile + compensation +
// work history). The public IR endpoint reads from this — edits to
// UserProfile/CompensationPreference/WorkHistory don't go live until
// the user explicitly publishes from the work-mapping panel.
model PublishedProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  // Snapshot of UserProfile fields shown on the IR
  profileSnapshot      Json
  // Snapshot of CompensationPreference (sanitized — no hardFloor)
  compensationSnapshot Json?
  // Snapshot of WorkHistory[] with relations (galleryPhotos, attachments, equipment)
  workHistorySnapshot  Json?
  publishedAt          DateTime @default(now())
  // Free-form note the user can attach to a publish ("updated headline", etc.)
  publishNote          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Compensation Expectations ─────────────────────────────────
// Candidate-set pay requirements surfaced on the IR so recruiters can
// self-filter before reaching out. 1:1 with UserProfile.
model CompensationPreference {
  id                String  @id @default(uuid())
  profileId         String  @unique
  // Public range
  period            String  @default("annual") // annual | hourly | monthly
  currency          String  @default("USD")
  salaryMin         Int?
  salaryTarget      Int?
  salaryMax         Int?
  // Private hard floor — exact number is never sent to recruiters,
  // but we surface a "below candidate's minimum" badge if a comparison number is provided.
  hardFloor         Int?
  // Employment type preferences (JSON string array): full_time | part_time | contract | 1099 | internship | temp
  employmentTypes   String?
  // Openness flags
  openToRelocation  Boolean @default(false)
  openToEquity      Boolean @default(false)
  openToBonus       Boolean @default(true)
  openToSignOn      Boolean @default(false)
  remotePreference  String  @default("any") // any | remote | hybrid | onsite
  // Benefits must-haves (JSON string array): e.g. ["health","401k_match","unlimited_pto"]
  benefitsMustHaves String?
  notes             String?
  // Visibility on the IR: public | recruiters | hidden
  visibility        String  @default("public")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Stealth Mode: Access Requests ─────────────────────────────

model AccessRequest {
  id                String    @id @default(uuid())
  profileId         String
  requesterName     String
  requesterEmail    String
  requesterCompany  String?
  requesterLinkedin String?
  message           String?
  status            String    @default("pending") // pending | approved | denied
  approvedAt        DateTime?
  accessToken       String?   @unique // magic link token for approved access
  tokenExpiresAt    DateTime?
  // ── Per-share IR overrides (shown only to viewers using this token) ──
  targetRole        String? // override the default headline for this viewer
  focusSections     String? // JSON array of section types to highlight
  createdAt         DateTime  @default(now())

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Stealth Mode: Single-Use Links ────────────────────────────

model SingleUseLink {
  id            String    @id @default(uuid())
  profileId     String
  token         String    @unique
  label         String? // e.g. "For Recruiter at ABB"
  viewedAt      DateTime?
  viewedBy      String? // IP or user-agent of viewer
  expiresAt     DateTime
  // ── Per-share IR overrides ──
  targetRole    String? // override headline for this viewer
  focusSections String? // JSON array of section types to highlight
  createdAt     DateTime  @default(now())

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Equipment & Work Logs ─────────────────────────────────────

model Equipment {
  id           String    @id @default(uuid())
  positionId   String
  name         String
  category     String    @default("hardware")
  usage        String    @default("used") // "used" = assigned to you | "worked-on" = you maintained/operated
  manufacturer String?
  model        String?
  serialNumber String?
  assetTag     String?
  assignedDate DateTime?
  returnedDate DateTime?
  condition    String    @default("good")
  licenseKey   String?
  version      String?
  expiresAt    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  position  WorkHistory         @relation("WorkHistoryEquipment", fields: [positionId], references: [id], onDelete: Cascade)
  resources EquipmentResource[]
  photos    EquipmentPhoto[]
}

model EquipmentPhoto {
  id          String   @id @default(uuid())
  equipmentId String
  filePath    String
  fileName    String
  fileMime    String
  fileSize    Int
  caption     String?
  isCover     Boolean  @default(false)
  createdAt   DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

model EquipmentResource {
  id          String   @id @default(uuid())
  equipmentId String
  type        String   @default("manual")
  title       String
  content     String?
  fileName    String?
  fileData    Bytes?
  fileMime    String?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

// ─── Personal Inventory (user-scoped, not tied to a job) ───────

model PersonalEquipment {
  id            String    @id @default(uuid())
  userId        String
  name          String
  category      String    @default("tool") // hardware | software | vehicle | safety | tool | instrument | other
  ownership     String    @default("personal") // personal | shared | borrowed | rental
  manufacturer  String?
  model         String?
  serialNumber  String?
  condition     String    @default("good") // new | good | fair | poor
  proficiency   Int? // 1-5 self-rated
  purchaseDate  DateTime?
  purchasePrice Float?
  currentValue  Float?
  location      String? // where it's stored
  isPrivate     Boolean   @default(true) // hide from public IR by default
  isDraft       Boolean   @default(false) // true when created via bulk-photo upload, awaiting details
  notes         String?
  tags          String[]  @default([]) // free-text user tags
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos PersonalEquipmentPhoto[]
  kits   EquipmentKitItem[]

  @@index([userId])
}

model PersonalEquipmentPhoto {
  id          String   @id @default(uuid())
  equipmentId String
  filePath    String
  fileName    String
  fileMime    String
  fileSize    Int
  caption     String?
  isCover     Boolean  @default(false)
  sortOrder   Int      @default(0)
  focalX      Int      @default(50) // 0-100, horizontal focal point %
  focalY      Int      @default(50) // 0-100, vertical focal point %
  zoom        Float    @default(1) // 1.0 = cover (no extra zoom)
  rotation    Int      @default(0) // degrees, multiples of 90 (0/90/180/270)
  flipH       Boolean  @default(false)
  flipV       Boolean  @default(false)
  createdAt   DateTime @default(now())

  equipment PersonalEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

// ─── Equipment Kits / Collections ─────────────────────────────

model EquipmentKit {
  id          String   @id @default(uuid())
  userId      String
  name        String // e.g. "Plumbing kit", "Camping gear"
  description String?
  color       String? // optional hex/color token for chip
  icon        String? // optional lucide icon key
  isPrivate   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items EquipmentKitItem[]

  @@unique([userId, name])
  @@index([userId])
}

model EquipmentKitItem {
  id          String   @id @default(uuid())
  kitId       String
  equipmentId String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  kit       EquipmentKit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  equipment PersonalEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([kitId, equipmentId])
  @@index([kitId])
  @@index([equipmentId])
}

model PersonalEquipmentShare {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  label        String? // optional name like "For Bob"
  scope        String    @default("all") // "all" | "selected" | "kit"
  itemIds      String[]  @default([]) // when scope = "selected"
  kitId        String? // when scope = "kit"
  expiresAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkLog {
  id             String    @id @default(uuid())
  userId         String
  positionId     String?
  shiftId        String?
  date           DateTime
  workdayDate    DateTime?
  title          String
  content        String? // plain-text projection (search, exports, legacy readers)
  contentJson    Json? // ProseMirror JSON (rich editor source of truth — Phase 1b)
  category       String    @default("task")
  hours          Float?
  tags           String?
  accomplishment Boolean   @default(false)
  impact         String?

  // ── Phase A extensions (item #19) ──
  isNotable               Boolean  @default(false) // surfaces in highlights feed
  mood                    String? // optional: happy | neutral | tough (emoji or token)
  templateId              String? // link to WorkLogTemplate used to create this entry
  isAutoGenerated         Boolean  @default(false) // future: implicit logging from photos / calendar / etc.
  equipmentIds            String[] @default([]) // PersonalEquipment IDs touched today (Postgres array, simple link)
  assetIds                String[] @default([]) // JobAsset IDs worked on today (employer/customer-owned machines, units, vehicles)
  // ADR-0016: note-to-note links. Denormalized projection of @n: mentions in
  // contentJson, populated on save by extractMentionEntityIds(doc, "worklog").
  // Backlinks panel = findMany({ where: { linkedNoteIds: { has: id } } }).
  linkedNoteIds           String[] @default([])
  promotedToCareerEventId String? // set when user promotes this entry to a CareerEvent on the IR
  visibility              String   @default("PRIVATE") // PRIVATE | TEAM | PUBLIC — only PRIVATE used in Phase A

  // ── Phase B implicit logging (item #19) ──
  externalSource String? // null | "ics" | "github" | "google-calendar" | "microsoft-graph"
  externalId     String? // provider-specific event/commit/PR id (used for dedupe on re-sync)

  // ── User-defined folder hierarchy (Phase C item #20) ──
  folderId  String?
  sortOrder Int     @default(0) // drag-reorder position within folder (W2.1)

  // ── Archive bucket (ADR-0026) ──
  // Gmail-style soft archive. NULL = active note (default surface). Non-null
  // = hidden from the active list / search / All Notes; visible only via the
  // dedicated `?archived=1` filter (sidebar "Archived" view). Hard delete
  // remains separate (DELETE /api/work-logs/[id]) — archive is not trash.
  archivedAt DateTime?

  // ── Full-text search (W1.2) ──
  // GENERATED STORED tsvector maintained by Postgres — see migration
  // 20260523220000_add_worklog_search_vector. Combines title (A), content (B), tags (C).
  searchVector Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  position WorkHistory?      @relation("WorkHistoryWorkLogs", fields: [positionId], references: [id], onDelete: Cascade)
  shift    WorkHistoryShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  template WorkLogTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  folder   WorkLogFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  photos   WorkLogPhoto[]
  drafts   WorkLogDraft[]
  versions WorkLogVersion[]
  imports  WorkLogImport[]

  @@unique([userId, externalSource, externalId], map: "WorkLog_external_unique")
  @@index([userId, date])
  @@index([userId, workdayDate])
  @@index([userId, folderId])
  @@index([userId, folderId, sortOrder])
  @@index([userId, archivedAt])
  @@index([positionId, shiftId])
  @@index([positionId])
  @@index([templateId])
  @@index([searchVector], type: Gin)
  @@index([linkedNoteIds], type: Gin)
}

// User-defined folder tree (adjacency list) for organizing WorkLog notes.
// Folders coexist with the `category` field — categories remain a
// cross-cutting "kind" tag while folders provide hierarchical organization.
model WorkLogFolder {
  id        String   @id @default(uuid())
  userId    String
  name      String // 1..80 chars, validated server-side
  parentId  String? // null = root
  color     String? // optional tailwind hue token, e.g. "blue"
  icon      String? // optional lucide icon name (future)
  sortOrder Int      @default(0) // reserved for manual drag-reorder (Phase D)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   WorkLogFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children WorkLogFolder[] @relation("FolderTree")
  workLogs WorkLog[]

  @@index([userId, parentId])
  @@index([userId, sortOrder])
}

// User-defined category taxonomy for organizing WorkLog notes. Categories
// are a second axis next to WorkLogFolder: the folder is a *location* in a
// tree, the category is a cross-cutting *kind* tag ("task", "project", etc.).
//
// `WorkLog.category` continues to hold the category NAME (free-form string),
// not a FK. This avoids migrating every existing note row and lets renames be
// a single bulk UPDATE on the user's notes (see /api/work-logs/categories).
//
// The reserved name "other" is the permanent fallback bucket — it is never
// stored as a row in this table. Deleting a category bulk-updates its notes'
// category field to "other".
model WorkLogCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String // 1..40 chars, validated server-side; lower-case is recommended for stability
  sortOrder Int      @default(0) // reserved for future drag-reorder
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Case-sensitive unique-per-user — matches how WorkLog.category strings are stored.
  @@unique([userId, name])
  @@index([userId, sortOrder])
}

// Audit + dedupe row for each note-import attempt (Markdown/HTML files,
// future: Notion/OneNote/etc.). One row per (userId, sourceType, fingerprint)
// — the unique constraint lets the API detect "user uploaded the same file
// twice" and return the existing WorkLog instead of creating a duplicate.
//
// `droppedBlocks` stores the ImportResult.droppedBlocks payload as JSON so
// future UI can surface "12 unsupported blocks skipped" without re-parsing.
model WorkLogImport {
  id                String    @id @default(uuid())
  userId            String
  sourceType        String // "markdown" | "html" | future: "notion" | "onenote"
  sourceFingerprint String // sha256 hex of source bytes
  sourceFilename    String? // optional original filename
  status            String    @default("pending") // "pending" | "succeeded" | "failed"
  errorMessage      String?
  droppedBlocks     Json?
  workLogId         String?   @unique // links to the created WorkLog on success
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workLog WorkLog? @relation(fields: [workLogId], references: [id], onDelete: SetNull)

  @@unique([userId, sourceType, sourceFingerprint], map: "WorkLogImport_dedupe")
  @@index([userId, createdAt])
  @@index([userId, status])
}

// Reusable shift windows for a specific WorkHistory job.
model WorkHistoryShift {
  id            String   @id @default(uuid())
  userId        String
  workHistoryId String
  name          String
  startMinute   Int // 0..1439
  endMinute     Int // 0..1439
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workHistory                  WorkHistory         @relation(fields: [workHistoryId], references: [id], onDelete: Cascade)
  workLogs                     WorkLog[]
  defaultForWorkLogPreferences WorkLogPreference[] @relation("WorkLogPreferenceDefaultShift")

  @@index([userId, workHistoryId])
  @@index([workHistoryId, isActive])
}

// Per-user defaults applied to new worklog creation.
model WorkLogPreference {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  defaultPositionId         String?
  defaultShiftId            String?
  defaultCategory           String    @default("task")
  defaultMood               String?
  defaultHours              Float?
  /// First-time consent for in-browser voice dictation (ADR-0020). Null = not yet consented.
  voiceDictationConsentedAt DateTime?
  /// ADR-0023 — worklog reader right-rail active tab. One of: backlinks | history | tags | photos.
  readerRailTab             String    @default("backlinks")
  /// ADR-0023 — worklog reader right-rail collapsed state. True hides the 320px content panel.
  readerRailCollapsed       Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultPosition WorkHistory?      @relation("WorkLogPreferenceDefaultPosition", fields: [defaultPositionId], references: [id], onDelete: SetNull)
  defaultShift    WorkHistoryShift? @relation("WorkLogPreferenceDefaultShift", fields: [defaultShiftId], references: [id], onDelete: SetNull)

  @@index([defaultPositionId])
  @@index([defaultShiftId])
}

// ─── Work Log Drafts (Phase 2 — cross-device persisted edits) ───────────
// Field-level draft rows used by reader autosave write-through.
// Last-write-wins by updatedAt. Entries expire after 7 days by policy.
model WorkLogDraft {
  id        String   @id @default(uuid())
  userId    String
  workLogId String
  field     String
  valueJson Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workLog WorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  @@unique([userId, workLogId, field])
  @@index([userId, workLogId])
  @@index([expiresAt])
}

// ─── Work Log Versions (ADR-0017 — version history + visual diff) ───────
// Snapshot rows above the Y.js operation log. Each row is a complete
// projection of WorkLog.contentJson at the moment of capture.
//
// Snapshot triggers (per ADR-0017):
//   1. Auto: server-side on PUT /work-logs/[id] when
//      (now - lastSnapshotAt) > 30s AND |plainTextLen delta| >= 50.
//   2. Manual: POST /work-logs/[id]/versions { label }.
//   3. Pre-restore: always, label = "Before restore from <timestamp>".
//
// Retention (run inline on save, guarded for cost):
//   - Last hour: keep newest 10 auto-snapshots.
//   - 1h–24h:    keep one per hour.
//   - >24h:      keep one per calendar day.
//   - Manual snapshots: never auto-deleted; per-note cap of 50 (FIFO).
//
// Restore = copy contentJson over WorkLog.contentJson. No merge logic.
model WorkLogVersion {
  id          String   @id @default(uuid())
  workLogId   String
  userId      String
  contentJson Json
  plainText   String? // cached projection — avoid rehydrating ProseMirror for previews
  label       String? // user-set name on manual snapshots, or auto label for pre-restore
  isManual    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workLog WorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workLogId, createdAt])
  @@index([userId])
}

// ─── Work Log Photos (item #19 Phase A — visual evidence) ────────
// Optional photo attachments on a worklog entry. Distinct from EquipmentPhoto / JobAsset photos:
// these document THIS DAY's work (e.g. before/after of a repair, screenshot of a deploy).
model WorkLogPhoto {
  id        String   @id @default(uuid())
  workLogId String
  filePath  String
  fileName  String
  fileMime  String
  fileSize  Int
  caption   String?
  sortOrder Int      @default(0)
  /// "panel" = uploaded via the Photos disclosure section (capped at 6 per log)
  /// "body"  = inline image embedded inside a worklog note via the rich editor (cap 20 per log)
  source    String   @default("panel")
  createdAt DateTime @default(now())

  workLog WorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  @@index([workLogId])
  @@index([workLogId, source])
}

// ─── Work Log Templates (item #19 Phase A — "day types") ────────
// User-defined reusable presets so most days can be logged in seconds.
// E.g. "Standard onsite — Acme" = position + category + tags + tools, all pre-filled.
model WorkLogTemplate {
  id          String  @id @default(uuid())
  userId      String
  name        String // e.g. "Standard onsite — Acme"
  description String?
  icon        String? // optional lucide icon key
  color       String? // optional accent color token

  // ── Defaults applied when creating a log from this template ──
  defaultPositionId      String?
  defaultCategory        String   @default("task")
  defaultTitle           String?
  defaultTags            String? // comma-separated, mirrors WorkLog.tags
  defaultEquipmentIds    String[] @default([])
  defaultAssetIds        String[] @default([])
  defaultMood            String?
  defaultDurationMinutes Int? // optional default work duration

  sortOrder  Int       @default(0)
  useCount   Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  position WorkHistory? @relation("WorkHistoryWorkLogTemplates", fields: [defaultPositionId], references: [id], onDelete: SetNull)
  workLogs WorkLog[]

  @@index([userId])
  @@index([defaultPositionId])
}

// ─── Integration Connection (item #19 Phase B — implicit logging from external systems) ───
// Lightweight per-user connection metadata for low-friction sources (no OAuth yet):
//   - "ics"    : a public .ics calendar URL (Google "Secret iCal", Outlook published cal, etc.)
//   - "github" : a public GitHub username — pulls public events (commits, PRs, issues) only
// OAuth providers (google-calendar, microsoft-graph, github-oauth) will reuse this row with
// an additional encrypted token blob in `config` once that work lands.
model IntegrationConnection {
  id             String    @id @default(uuid())
  userId         String
  provider       String // "ics" | "github" | future OAuth provider keys
  label          String? // user-facing nickname ("Work calendar", "@my-handle")
  config         Json      @default("{}") // { url?, username?, repoFilter?, scopes?, tokenRef? }
  enabled        Boolean   @default(true)
  lastSyncedAt   DateTime?
  lastSyncStatus String? // "ok" | "error: ..."
  lastSyncCount  Int       @default(0) // # of WorkLog rows touched on the last sync
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, label])
  @@index([userId])
}

// ─── Job Assets (employer / customer-owned things the user works ON) ────────
// Distinct from PersonalEquipment (which the user owns and brings).
// Examples: a CNC machine at a factory, a tenant's HVAC unit, Truck #427,
// Building 3 elevator. Tracked so the user can see service history per asset
// and reference them from worklog entries.
model JobAsset {
  id           String  @id @default(uuid())
  userId       String // owner of the record (the worker)
  name         String // "Compressor C-204", "Truck 427", "RTU-3"
  assetTypeId  String? // link to AssetType knowledge profile (replaces old assetType enum)
  identifier   String? // asset tag / unit # / VIN / serial at the site
  manufacturer String?
  model        String?
  serialNumber String?

  // Where it lives — at most one of these is typically set
  positionId   String? // belongs to this employer/position
  customerName String? // for service techs hitting many customer sites
  location     String? // "Building 3, Floor 2" / site address

  status         String    @default("active") // active | retired | out-of-service
  installedAt    DateTime?
  commissionedAt DateTime?

  notes     String?
  tags      String[] @default([])
  isPrivate Boolean  @default(true)
  isDraft   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  WorkHistory?    @relation("WorkHistoryJobAssets", fields: [positionId], references: [id], onDelete: SetNull)
  type      AssetType?      @relation(fields: [assetTypeId], references: [id], onDelete: SetNull)
  photos    JobAssetPhoto[]
  documents AssetDocument[]
  links     AssetLink[]

  @@index([userId])
  @@index([positionId])
  @@index([assetTypeId])
}

model JobAssetPhoto {
  id        String   @id @default(uuid())
  assetId   String
  filePath  String
  fileName  String
  fileMime  String
  fileSize  Int
  caption   String?
  isCover   Boolean  @default(false)
  sortOrder Int      @default(0)
  focalX    Int      @default(50)
  focalY    Int      @default(50)
  zoom      Float    @default(1)
  rotation  Int      @default(0)
  flipH     Boolean  @default(false)
  flipV     Boolean  @default(false)
  createdAt DateTime @default(now())

  asset JobAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

// ─── Attachments (files linked to a work history entry) ────────

model Attachment {
  id         String   @id @default(uuid())
  positionId String
  label      String // user-facing name, e.g. "Offer Letter"
  category   String   @default("other") // "offer-letter" | "w2" | "pay-stub" | "contract" | "cert" | "review" | "other"
  fileName   String // original file name
  filePath   String // server path under /uploads/attachments/
  fileMime   String // e.g. "application/pdf"
  fileSize   Int // bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  position WorkHistory @relation("WorkHistoryAttachments", fields: [positionId], references: [id], onDelete: Cascade)
}

// ─── Gallery Videos (multiple videos per work history entry) ───

model GalleryVideo {
  id                String    @id @default(uuid())
  workHistoryId     String
  albumId           String?
  filePath          String // /uploads/gallery/videos/xxx.mp4 OR external URL when isEmbed
  fileName          String // original file name or display title for embeds
  fileMime          String // video/mp4 etc, or "embed/youtube" | "embed/vimeo" | "embed/loom" | "embed/other"
  fileSize          Int // bytes (0 for embeds)
  posterPath        String? // optional poster image (or remote thumbnail URL for embeds)
  durationSec       Float? // optional duration in seconds
  width             Int? // optional intrinsic width
  height            Int? // optional intrinsic height
  isEmbed           Boolean   @default(false) // true → render iframe / external player
  embedProvider     String? // youtube | vimeo | loom | other
  caption           String?
  isCover           Boolean   @default(false)
  isFavorite        Boolean   @default(false)
  isPrivate         Boolean   @default(false)
  annotationsPublic Boolean   @default(true)
  tags              String? // JSON array of tag strings
  dateTaken         DateTime?
  sortOrder         Int?
  createdAt         DateTime  @default(now())

  workHistory WorkHistory       @relation("WorkHistoryGalleryVideos", fields: [workHistoryId], references: [id], onDelete: Cascade)
  album       GalleryAlbum?     @relation("GalleryAlbumVideos", fields: [albumId], references: [id], onDelete: SetNull)
  annotations MediaAnnotation[] @relation("GalleryVideoAnnotations")

  @@index([workHistoryId])
  @@index([albumId])
}

// ─── Gallery Photos (multiple photos per work history entry) ───

model GalleryPhoto {
  id                String    @id @default(uuid())
  workHistoryId     String
  albumId           String?
  filePath          String // /uploads/gallery/xxx.jpg
  fileName          String // original file name
  fileMime          String // image/jpeg etc
  fileSize          Int // bytes
  caption           String? // optional caption
  isCover           Boolean   @default(false)
  isFavorite        Boolean   @default(false)
  isPrivate         Boolean   @default(false)
  // Marks photo for inclusion in the work-history banner slideshow.
  isBanner          Boolean   @default(false)
  annotationsPublic Boolean   @default(true) // when photo is shared, also expose annotations
  tags              String? // JSON array of tag strings, e.g. ["welding","safety"]
  markers           String? // legacy JSON pins (kept for back-compat); new feature uses MediaAnnotation
  dateTaken         DateTime?
  rotation          Int       @default(0) // 0, 90, 180, 270 — display rotation (non-destructive)
  sortOrder         Int?
  createdAt         DateTime  @default(now())

  workHistory WorkHistory       @relation("WorkHistoryGallery", fields: [workHistoryId], references: [id], onDelete: Cascade)
  album       GalleryAlbum?     @relation("GalleryAlbumPhotos", fields: [albumId], references: [id], onDelete: SetNull)
  annotations MediaAnnotation[] @relation("GalleryPhotoAnnotations")

  @@index([workHistoryId])
  @@index([albumId])
}

model GalleryAlbum {
  id            String   @id @default(uuid())
  workHistoryId String
  name          String
  sortOrder     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workHistory WorkHistory    @relation("WorkHistoryGalleryAlbums", fields: [workHistoryId], references: [id], onDelete: Cascade)
  photos      GalleryPhoto[] @relation("GalleryAlbumPhotos")
  videos      GalleryVideo[] @relation("GalleryAlbumVideos")

  @@unique([workHistoryId, name])
  @@index([workHistoryId])
}

// ─── Media Annotations (rich shapes + notes on photos/videos) ──

model MediaAnnotation {
  id             String   @id @default(uuid())
  photoId        String?
  videoId        String?
  kind           String // "pin" | "rect" | "circle" | "arrow" | "freehand"
  geometry       String // JSON; coords normalized 0..1 relative to media
  title          String?
  body           String? // rich-text HTML (tiptap output)
  color          String   @default("#ef4444")
  tags           String? // JSON array of tag strings
  sortOrder      Int? // null = not part of tour; numeric = step in tour
  videoTimestamp Float? // seconds; null for photos or persistent video annotations
  isPrivate      Boolean  @default(false) // override: hide on public surfaces even if photo is public
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  photo    GalleryPhoto?            @relation("GalleryPhotoAnnotations", fields: [photoId], references: [id], onDelete: Cascade)
  video    GalleryVideo?            @relation("GalleryVideoAnnotations", fields: [videoId], references: [id], onDelete: Cascade)
  comments MediaAnnotationComment[] @relation("AnnotationComments")

  @@index([photoId])
  @@index([photoId, sortOrder])
  @@index([videoId])
  @@index([videoId, sortOrder])
}

model MediaAnnotationComment {
  id           String   @id @default(uuid())
  annotationId String
  authorId     String // user id of comment author
  body         String // plain text or simple markdown
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  annotation MediaAnnotation @relation("AnnotationComments", fields: [annotationId], references: [id], onDelete: Cascade)

  @@index([annotationId])
  @@index([annotationId, createdAt])
}

// ─── Compensation & Benefits ───────────────────────────────────

model CompensationEvent {
