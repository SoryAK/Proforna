  createdAt     DateTime @default(now())

  position WorkHistory @relation("WorkHistoryCompensation", fields: [positionId], references: [id], onDelete: Cascade)
}

model Benefit {
  id           String    @id @default(uuid())
  positionId   String
  category     String    @default("health")
