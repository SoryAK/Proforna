  lat       Float
  lng       Float
  placeId   String? // Google Place ID for Feature Layer building highlight
  weight    Int      @default(3) // priority 1-5
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Work History (past jobs reference pins) ────────────────────

model WorkHistory {
  id              String  @id @default(uuid())
  userId          String
  type            String  @default("job") // "job" | "school" | "military" | "volunteer"
  company         String // company name or institution name
  title           String? // job title or degree name
  address         String
  lat             Float
  lng             Float
  placeId         String? // Google Place ID for Feature Layer building highlight
  osmWayId        Int? // OpenStreetMap way ID for building footprint outline (resolved on first focus, primary building only — kept for back-compat / fast path)
  osmWayIds       Int[]   @default([]) // Explicit list of OSM way IDs to outline (multi-building campus). When non-empty this overrides auto campus-sibling lookup.
  footprintCustom Json? // Optional hand-drawn polygon rings: Array<Array<{lat:number,lng:number}>>. Appended to OSM rings on render.
  startDate       String? // e.g. "2020-01" (year-month)
  endDate         String? // e.g. "2023-06" or null for "still there"

  // ── Education-specific ──
  degree String? // e.g. "B.S.", "M.S.", "A.A.S.", "High School Diploma"
  major  String? // e.g. "Computer Science", "Electrical Engineering"
  gpa    Float? // grade point average

  // ── Compensation ──
  salaryAmount   Float? // annual salary or hourly rate
  salaryType     String? // "annual" | "hourly"
  salaryCurrency String? @default("USD")
  bonusAmount    Float? // annual bonus
  equityNotes    String? // stock options / RSU notes

  // ── Schedule ──
  workMode     String? // "on-site" | "hybrid" | "remote"
  hybridDays   Int? // days per week on-site (for hybrid)
  scheduleType String? // "full-time" | "part-time" | "contract" | "internship" | "freelance"
  hoursPerWeek Float? // typical hours per week
  shiftNotes   String? // shift schedule notes

  // ── Benefits ──
  benefits String? // JSON array: ["health","dental","vision","401k","pto","hsa","fsa","life","disability","tuition","gym","stock"]

  // ── PTO / Vacation ──
  ptoDaysOffered Int? // PTO days offered per year
  ptoDaysUsed    Int? // PTO days actually used
  ptoNotes       String? // unlimited PTO, sabbatical, etc.

  // ── Work Environment ──
  companySize String? // "startup" | "small" | "mid-market" | "enterprise"
  department  String? // department or division
  teamSize    Int? // how many people on your team
  managerName String? // who you reported to

  // ── Skills & Growth ──
  skillsUsed   String? // JSON array of skill names used
  skillsGained String? // JSON array of skill names gained
  promotions   String? // JSON array: [{"title":"Senior Dev","date":"2022-06"}]

  // ── Departure & Reflection ──
  reasonForLeaving String? // "better-offer" | "layoff" | "relocation" | "growth" | "culture" | "personal" | "contract-end" | "other"
  wouldReturn      String? // "yes" | "no" | "maybe"
  accomplishments  String? // JSON array of key accomplishment strings

  // ── Commute (auto-calculated or manual) ──
  commuteMinutes  Int? // average one-way commute time
  commuteDistance Float? // average one-way distance in miles
  commuteMode     String? // "driving" | "transit" | "walking" | "bicycling"

  // ── Payroll / Employer Detail (absorbed from CurrentPosition) ──
  isActive                Boolean  @default(false) // currently employed here
  location                String? // city-level location string
  description             String? // role description
  responsibilities        String? // line-separated responsibilities
  techStack               String? // comma-separated tools/tech
  ein                     String? // employer identification number
  legalName               String? // legal filing name
  companySynopsis         String? // brief company description
  industry                String? // industry sector
  website                 String? // company website URL
  // Set when the company has shut down / no longer in operation. Surfaced as a "Closed" badge.
  companyClosed           Boolean  @default(false)
  // Set when this primary work location/branch is closed but the company is still operating.
  locationClosed          Boolean  @default(false)
  focus                   String? // primary role summary
  schedule                String? // free-text schedule (e.g. "Overnight 6pm-6am")
  payRate                 String? // base rate string (e.g. "$35.50/hr")
  payType                 String?  @default("salary") // "salary" | "hourly" | "contract"
  differentials           String? // newline-separated pay differentials
  payFrequency            String?  @default("biweekly") // "weekly" | "biweekly" | "semimonthly" | "monthly"
  rotatingSchedule        Boolean  @default(false) // alternating weekly schedules
  scheduleBHours          Float? // schedule B hours per week
  otHoursA                Float? // overtime hours schedule A
  otHoursB                Float? // overtime hours schedule B
  otRate                  Float?   @default(1.5) // overtime multiplier
  annualRaiseMin          Float? // min annual raise %
  annualRaiseMax          Float? // max annual raise %
  estimatorSettings       String? // JSON blob for paycheck estimator
  coverImage              String? // base64 cover photo
  coverImageY             Float?   @default(50) // vertical focal point 0–100 for banner crop
  // Per-job override for the global UserProfile.bannerSlideshowEnabled setting.
  // null = use user default; true/false = explicit override.
  bannerSlideshowOverride Boolean?
  uniformData             String? // JSON blob: { enabled, category, zones: { [zoneId]: { item, color, providedBy, notes, photo } } }
  hoverNote               String? // Custom recruiter-facing note shown in the building-outline hover tooltip (item #10 follow-up). Plain text + URLs; ~280 chars.
  outlineColor            String? // Custom hex color (e.g. #10b981) for the building-outline polygon. Null = default emerald.
  outlineOverrides        Json? // Per-ring overrides keyed by stable ringKey (first-3-coords of the polygon). Shape: { [ringKey]: { color?: string, note?: string } }. Lets the user color/note individual buildings on a multi-building campus.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations                    WorkHistoryLocation[]
  notes                        WorkHistoryNote[]
  milestones                   WorkHistoryMilestone[]
  rating                       WorkplaceRating?
  diffusionExposures           DiffusionExposure[]
  careerEvents                 CareerEvent[]
  compensation                 CompensationEvent[]    @relation("WorkHistoryCompensation")
  benefitRecords               Benefit[]              @relation("WorkHistoryBenefits")
  timeOff                      TimeOffBalance[]       @relation("WorkHistoryTimeOff")
  paychecks                    PaycheckRecord[]       @relation("WorkHistoryPaychecks")
  equipment                    Equipment[]            @relation("WorkHistoryEquipment")
  workLogs                     WorkLog[]              @relation("WorkHistoryWorkLogs")
  shifts                       WorkHistoryShift[]
  defaultForWorkLogPreferences WorkLogPreference[]    @relation("WorkLogPreferenceDefaultPosition")
  workLogTemplates             WorkLogTemplate[]      @relation("WorkHistoryWorkLogTemplates")
  jobAssets                    JobAsset[]             @relation("WorkHistoryJobAssets")
  attachments                  Attachment[]           @relation("WorkHistoryAttachments")
  galleryPhotos                GalleryPhoto[]         @relation("WorkHistoryGallery")
  galleryVideos                GalleryVideo[]         @relation("WorkHistoryGalleryVideos")
  galleryAlbums                GalleryAlbum[]         @relation("WorkHistoryGalleryAlbums")
}

// ─── Residence History (where the user lived over time) ─────────
model Residence {
  id        String  @id @default(uuid())
  userId    String
  label     String // e.g. "College dorm", "First apartment", "Family home"
  address   String
  lat       Float
  lng       Float
  placeId   String? // Google Place ID
  startDate String? // e.g. "2018-08"
  endDate   String? // null = still living here
  isCurrent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Work History Locations (sub-locations per job) ─────────────

model WorkHistoryLocation {
  id               String   @id @default(uuid())
  workHistoryId    String
  label            String // e.g. "Downtown satellite office"
  type             String   @default("daily-workplace") // daily-workplace | main-office | satellite | remote | client-site
  address          String
  lat              Float
  lng              Float
  placeId          String? // Google Place ID for Feature Layer building highlight
  isPrimary        Boolean  @default(false) // used for polyline path
  includeInOutline Boolean  @default(false) // include this sub-location in auto building-outline detection
  // Set when this specific sub-location is closed (the company / other locations may still operate).
  closed           Boolean  @default(false)
  skills           String? // JSON array of skill names used at this location
  photos           String? // JSON array of photo URLs or base64 data URIs
  startDate        String? // optional YYYY-MM period start at this location
  endDate          String? // optional YYYY-MM period end at this location
  hoverNote        String? // Custom recruiter-facing note shown in the per-location building-outline hover tooltip. Overrides parent WorkHistory.hoverNote when present.
  outlineColor     String? // Custom hex color override for this sub-location's polygon. Overrides parent WorkHistory.outlineColor when present.
  // Per sub-location cover photo shown in the on-hover popup. When null, the
  // parent WorkHistory.coverImage is used as a fallback.
  coverImage       String?
  coverImageY      Float?   @default(50)
  createdAt        DateTime @default(now())

  workHistory WorkHistory @relation(fields: [workHistoryId], references: [id], onDelete: Cascade)

  @@index([workHistoryId])
}

// ─── Work History Notes ────────────────────────────────────────

model WorkHistoryNote {
  id            String   @id @default(uuid())
  workHistoryId String
  content       String
  imageUrl      String? // optional photo URL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workHistory WorkHistory @relation(fields: [workHistoryId], references: [id], onDelete: Cascade)

  @@index([workHistoryId])
}

// ─── Work History Milestones ───────────────────────────────────

model WorkHistoryMilestone {
  id            String   @id @default(uuid())
  workHistoryId String
  title         String
  description   String?
  type          String   @default("achievement") // promotion | project | certification | award | achievement | other
  date          String // "2024-03" year-month format
  createdAt     DateTime @default(now())

  workHistory WorkHistory @relation(fields: [workHistoryId], references: [id], onDelete: Cascade)

  @@index([workHistoryId])
}

// ─── Workplace Rating ──────────────────────────────────────────

model WorkplaceRating {
  id              String   @id @default(uuid())
  workHistoryId   String   @unique
  culture         Int      @default(0) // 0-5
  growth          Int      @default(0) // 0-5
  compensation    Int      @default(0) // 0-5
  workLifeBalance Int      @default(0) // 0-5
  management      Int      @default(0) // 0-5
  overall         Int      @default(0) // 0-5
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workHistory WorkHistory @relation(fields: [workHistoryId], references: [id], onDelete: Cascade)
}

// ─── Email Leads (Job Search) ───────────────────────────────────

model EmailLead {
  id          String    @id @default(uuid())
  userId      String
  title       String
  company     String
  location    String
  lat         Float     @default(0)
  lng         Float     @default(0)
  salaryMin   Float?
  salaryMax   Float?
  applyUrl    String?
  source      String // indeed, linkedin, glassdoor, ziprecruiter, other
  emailDate   DateTime?
  description String    @default("")
  dedupeHash  String // hash of title+company+location for dedup
  expiresAt   DateTime // TTL — auto-prune after this date
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeHash])
  @@index([userId, expiresAt])
}

// ─── Company Job Postings ──────────────────────────────────────

model JobPosting {
  id               String    @id @default(uuid())
  userId           String?
  slug             String    @unique @default(uuid())
  company          String
  companyLogo      String?
  role             String
  department       String?
  location         String?
  type             String    @default("remote") // remote, hybrid, onsite
  employmentType   String    @default("full_time") // full_time, part_time, contract, internship, temporary
  experienceLevel  String    @default("mid") // entry, mid, senior, lead, executive
  salaryMin        Int?
  salaryMax        Int?
  currency         String    @default("USD")
  payFrequency     String    @default("yearly") // hourly, yearly
  description      String
  requirements     String?
  niceToHave       String?
  benefits         String?
  techStack        String? // comma-separated
  applicationUrl   String? // external link or null for in-app
  contactEmail     String?
  ein              String?
  isPublished      Boolean   @default(false)
  isFeatured       Boolean   @default(false)
  expiresAt        DateTime?
  viewCount        Int       @default(0)
  applicationCount Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isPublished, createdAt])
  @@index([company])
  @@index([type, experienceLevel])
}

// ─── Recruiter Location Accuracy ───────────────────────────────

/// Crowdsourced recruiter flags (Waze-model)
model RecruiterFlag {
  id          String   @id @default(uuid())
  companyNorm String // lowercased, trimmed company name
  userId      String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyNorm, userId]) // one flag per user per company
  @@index([companyNorm])
}

/// Persisted address overrides for map jobs (keyed by external job ID)
model AddressOverride {
  id           String   @id @default(uuid())
  userId       String
  jobKey       String // external job id (Adzuna/Google)
  address      String
  lat          Float
  lng          Float
  landmarkName String? // resolved landmark at override address
  source       String   @default("manual") // manual | nlp | landmark-swap
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobKey])
  @@index([userId])
}

// ─── Career Directional Model (CDM) ───────────────────────────

/// A skill domain node in the decomposition tree (e.g. "Electrical Engineering").
model SkillDomain {
  id        String   @id @default(cuid())
  name      String
  parentId  String? // self-referential hierarchy handled at app level
  socCodes  String? // JSON array of SOC codes in this domain
  keySkills String? // JSON array of core skill names
  createdAt DateTime @default(now())

  combinations DomainCombinationDomain[]
}

/// Join table linking a DomainCombination to its constituent SkillDomains.
model DomainCombinationDomain {
  id            String @id @default(cuid())
  combinationId String
  domainId      String

  combination DomainCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  domain      SkillDomain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([combinationId, domainId])
}

/// A specific combination of skill domains and the roles it unlocks.
model DomainCombination {
  id        String                    @id @default(cuid())
  roles     String // JSON array of role title strings
  socCodes  String? // JSON array of SOC codes for those roles
  salaryMin Int?
  salaryMax Int?
  level     String                    @default("mid") // entry | mid | senior | lead | executive
  treeId    String
  tree      DecompositionTree         @relation(fields: [treeId], references: [id], onDelete: Cascade)
  domains   DomainCombinationDomain[]
  createdAt DateTime                  @default(now())
}

/// Root of a skill decomposition tree for a given target role.
model DecompositionTree {
  id            String              @id @default(cuid())
  targetRole    String
  targetSocCode String?
  userId        String
  pathId        String?
  combinations  DomainCombination[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  path CareerPath? @relation(fields: [pathId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([targetRole])
}

/// Cluster of synonymous job titles for a canonical role.
model TitleSynonymCluster {
  id             String   @id @default(cuid())
  canonicalTitle String
  synonyms       String // JSON array of { title, frequency, companies, regionBias }
  socCodes       String? // JSON array
  skillOverlap   Int      @default(0) // 0-100 percentage
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([canonicalTitle])
  @@index([userId])
}

model SavedSearch {
  id        String    @id @default(cuid())
  userId    String
  name      String
  query     String    @default("")
  location  String
  radius    String    @default("25")
  source    String    @default("both")
  lat       Float?
  lng       Float?
  filters   String? // JSON: { minSalary, datePosted, remoteFilter, employmentType, hoursFilter, categoryFilter }
  lastRunAt DateTime?
  lastCount Int       @default(0)
  newCount  Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Skill Knowledge Graph ─────────────────────────────────────

/// A node in the skill graph — represents a single skill concept.
model SkillNode {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   @default("technical") // technical | soft | domain | tool
  source    String   @default("user") // user | market | ai | onet
  metadata  String? // JSON: { socCodes, description, aliases }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  edgesFrom              SkillEdge[]                  @relation("EdgeFrom")
  edgesTo                SkillEdge[]                  @relation("EdgeTo")
  evidence               SkillEvidence[]
  occupationRequirements OccupationSkillRequirement[]
  diffusionExposures     DiffusionExposure[]
  careerEventSkills      CareerEventSkill[]

  @@unique([userId, name])
  @@index([userId])
  @@index([name])
}

/// An edge connecting two SkillNodes — typed and weighted.
model SkillEdge {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  type      String   @default("peer") // prerequisite | peer | bridge | child | enables
  weight    Float    @default(1.0) // market frequency or AI confidence 0-10
  source    String   @default("ai") // job_posting | onet | ai | user
  metadata  String? // JSON: { jobCount, confidence, reasoning }
  createdAt DateTime @default(now())

  from SkillNode @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   SkillNode @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([fromId])
  @@index([toId])
}

/// Evidence linking a SkillNode to proof artifacts (work history, certs, projects, learning).
model SkillEvidence {
  id           String    @id @default(cuid())
  userId       String
  skillNodeId  String
  artifactType String // work_history | certification | learning_item | project | self_assessed
  artifactId   String    @default(cuid()) // FK to source record, or auto-generated ID for self-assessed
  strength     Float     @default(50) // 0-100 evidence strength
  notes        String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillNode SkillNode @relation(fields: [skillNodeId], references: [id], onDelete: Cascade)

  @@unique([skillNodeId, artifactType, artifactId])
  @@index([userId])
  @@index([skillNodeId])
}

/// Tracks which scaffold cluster was seeded for a user and when, enabling refresh detection.
model ScaffoldMeta {
  id          String    @id @default(cuid())
  userId      String
  cluster     String // SOC group name, e.g. "Computer and Mathematical"
  version     String // scaffold data version, e.g. "1.0.0"
  nodesSeeded Int       @default(0)
  edgesSeeded Int       @default(0)
  seededAt    DateTime  @default(now())
  refreshedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cluster])
  @@index([userId])
}

// ─── Occupations ───────────────────────────────────────────────

/// An occupation (job role) aligned to SOC/O*NET, linked to required skills.
model Occupation {
  id          String   @id @default(cuid())
  userId      String
  socCode     String // O*NET SOC code, e.g. "15-1252.00"
  title       String // "Software Developers"
  description String?
  cluster     String // scaffold cluster name, e.g. "Computer and Mathematical"
  source      String   @default("onet") // onet | ai | user
  metadata    String? // JSON: { bright_outlook, median_wage, growth }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements OccupationSkillRequirement[]
  interests    UserOccupationInterest[]

  @@unique([userId, socCode])
  @@index([userId])
  @@index([cluster])
}

/// Links an Occupation to a SkillNode with importance and proficiency level.
model OccupationSkillRequirement {
  id           String   @id @default(cuid())
  occupationId String
  skillNodeId  String
  importance   Float    @default(50) // 0-100, how critical this skill is to the occupation
  level        Float    @default(3.5) // 0-7, O*NET proficiency scale
  source       String   @default("onet") // onet | ai | user
  createdAt    DateTime @default(now())

  occupation Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  skillNode  SkillNode  @relation(fields: [skillNodeId], references: [id], onDelete: Cascade)

  @@unique([occupationId, skillNodeId])
  @@index([occupationId])
  @@index([skillNodeId])
}

/// Tracks a user's interest in or relationship to a specific occupation.
model UserOccupationInterest {
  id           String   @id @default(cuid())
  userId       String
  occupationId String
  status       String   @default("exploring") // current | target | past | exploring
  fitScore     Float? // auto-calculated career fit 0-100
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  @@unique([userId, occupationId])
  @@index([userId])
  @@index([occupationId])
}

// ─── Map Drawing & Annotation ──────────────────────────────────

model MapDrawingLayer {
  id        String   @id @default(cuid())
  userId    String
  name      String
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  drawings MapDrawing[]

  @@index([userId])
}

model MapDrawing {
  id        String   @id @default(cuid())
  userId    String
  layerId   String?
  type      String // freehand | polygon | circle | polyline | rectangle | text | note | emoji | ruler | area
  data      Json // Fabric.js serialized object + geo-anchor {fabricJson, anchors: [{lat,lng}]}
  color     String   @default("#3B82F6")
  zoneType  String? // preferred | avoid | maybe
  label     String?
  scope     String   @default("global") // global | work-history | work-history:{id} | job:{id}
  visible   Boolean  @default(true)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  layer MapDrawingLayer? @relation(fields: [layerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([layerId])
}

// ─── Experience Diffusion Model (EDM) ──────────────────────────

/// Maps exposure intensity from a work-history role (diffusion source) to a skill/concept node.
/// Zone controls Gaussian falloff: CORE → NEAR → MID → FAR.
/// Intensity is the raw weight (0.0–1.0) before tenure scaling.
model DiffusionExposure {
  id            String @id @default(cuid())
  userId        String
  workHistoryId String // the diffusion SOURCE (role)
  skillNodeId   String // the exposure TARGET (concept/skill)

  zone         String // CORE | NEAR | MID | FAR
  intensity    Float // 0.0–1.0 base Gaussian weight before tenure scaling
  category     String // skill | process | role_exposure | equipment | domain_concept | industry
  exposureType String // direct | observed | collaborated | ambient

  createdAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workHistory WorkHistory @relation(fields: [workHistoryId], references: [id], onDelete: Cascade)
  skillNode   SkillNode   @relation(fields: [skillNodeId], references: [id], onDelete: Cascade)

  @@unique([workHistoryId, skillNodeId])
  @@index([userId])
  @@index([workHistoryId])
  @@index([skillNodeId])
  @@index([zone])
}

// ─── Career Events (projects, milestones, responsibilities, etc.) ───

/// A significant event within a work history role — projects, promotions,
/// incidents, launches, training, etc. Connected to skills via join table.
model CareerEvent {
  id            String    @id @default(cuid())
  userId        String
  workHistoryId String
  title         String // "Led GCP Migration", "Series B Launch"
  description   String? // Full narrative / STAR story
  category      String    @default("project") // project | milestone | responsibility | training | outcome | context_shift
  startDate     DateTime? // Full datetime for timeline
  endDate       DateTime? // Full datetime for timeline
  location      String? // Freeform location (city, venue, etc)
  lat           Float? // Latitude for map display
  lng           Float? // Longitude for map display
  metrics       String? // Freeform quantified impact: "200 services", "$2M ARR"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workHistory WorkHistory        @relation(fields: [workHistoryId], references: [id], onDelete: Cascade)
  skills      CareerEventSkill[]
  photos      CareerEventPhoto[]

  @@index([userId])
  @@index([workHistoryId])
}

/// Photos attached to a CareerEvent — for "I was there" moments
/// (company dinners, field days, emergencies, news events, etc.)
model CareerEventPhoto {
  id            String   @id @default(uuid())
  careerEventId String
  filePath      String // /uploads/career-events/xxx.jpg
  fileName      String
  fileMime      String
  fileSize      Int
  caption       String?
  sortOrder     Int      @default(0)
  // Framing/orientation parity with PersonalEquipmentPhoto
  focalX        Int      @default(50)
  focalY        Int      @default(50)
  zoom          Float    @default(1)
  rotation      Int      @default(0)
  flipH         Boolean  @default(false)
  flipV         Boolean  @default(false)
  createdAt     DateTime @default(now())

  careerEvent CareerEvent @relation(fields: [careerEventId], references: [id], onDelete: Cascade)

  @@index([careerEventId])
}

/// Join table: which skills were involved in a career event.
model CareerEventSkill {
  id            String @id @default(cuid())
  careerEventId String
  skillNodeId   String

  careerEvent CareerEvent @relation(fields: [careerEventId], references: [id], onDelete: Cascade)
  skillNode   SkillNode   @relation(fields: [skillNodeId], references: [id], onDelete: Cascade)

  @@unique([careerEventId, skillNodeId])
  @@index([careerEventId])
  @@index([skillNodeId])
}

// ─── Employer Alias (fuzzy name resolution) ────────────────────

model EmployerAlias {
  id            String   @id @default(uuid())
  userId        String
  canonicalName String // the "real" display name the user chose
  variantName   String // an alternate spelling/abbreviation that maps to canonical
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, variantName])
  @@index([userId, canonicalName])
}

// ─── Asset Library — Sprint 1 (ADR-0012) ───────────────────────

// Generic equipment class — cross-employer knowledge layer.
// A user creates "Loss-in-Weight Feeder" once; every JobAsset of that class
// inherits its manuals, links, and skill mappings regardless of employer.
model AssetType {
  id           String   @id @default(uuid())
  userId       String
  name         String // "Loss-in-Weight Feeder", "Pneumatic Cylinder"
  category     String   @default("machine") // machine | vehicle | system | structure | unit | tool | other
  description  String?
  manufacturer String? // set when type is manufacturer-specific (e.g. "Schenck Process")
  tags         String[] @default([])
  isPublic     Boolean  @default(false) // reserved for future community sharing — always false in Sprint 1
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances JobAsset[]
  documents AssetDocument[]
  links     AssetLink[]

  @@index([userId])
}

// Documents attached to an AssetType (type-level: manufacturer manuals, spec sheets)
// OR to a JobAsset instance (instance-level: site-specific wiring diagrams).
// Exactly one of assetTypeId / assetId must be set.
model AssetDocument {
  id          String   @id @default(uuid())
  assetTypeId String?
  assetId     String?
  docType     String   @default("manual") // manual | wiring_diagram | spec_sheet | safety_sheet | parts_list | other
  title       String
  filePath    String? // uploaded file (e.g. /uploads/asset-docs/uuid.pdf)
  url         String? // external URL (manufacturer site, Google Drive)
  notes       String?
  createdAt   DateTime @default(now())

  assetType AssetType? @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  asset     JobAsset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetTypeId])
  @@index([assetId])
}

// Web links attached to an AssetType or JobAsset instance.
// Exactly one of assetTypeId / assetId must be set.
model AssetLink {
  id          String   @id @default(uuid())
  assetTypeId String?
  assetId     String?
  url         String
  title       String
  linkType    String   @default("other") // supplier | video | forum | article | datasheet | other
  notes       String?
  createdAt   DateTime @default(now())

  assetType AssetType? @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  asset     JobAsset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetTypeId])
  @@index([assetId])
}
