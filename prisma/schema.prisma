generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js v5 Models ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed — only for credentials auth
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  // ── App data relations ──
  profile             UserProfile?
  applications        JobApplication[]
  interviews          Interview[]
  contacts            Contact[]
  skills              Skill[]
  certifications      Certification[]
  resumeVersions      ResumeVersion[]
  goals               CareerGoal[]
  reminders           Reminder[]
  activityLogs        ActivityLog[]
  documents           Document[]
  positions           CurrentPosition[]
  submissions         RecruiterSubmission[]
  incomeYears         CareerIncomeYear[]
  wageTiers           WageTier[]
  emailAccounts       EmailAccount[]
  interactiveResumes  InteractiveResume[]
  careerPaths         CareerPath[]
  careerSnapshots     CareerSnapshot[]
  learningItems       LearningItem[]
  learningTopics      LearningTopic[]
  studySessions       StudySession[]
  researchFeeds       ResearchFeed[]
  marketSearches      MarketSearch[]
  companyProfiles     CompanyProfile[]
  interestGroups      InterestGroup[]
  interestGroupItems  InterestGroupItem[]
  jobPostings         JobPosting[]
  lifeAnchors         LifeAnchor[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Job Search & Applications ─────────────────────────────────

model JobApplication {
  id          String   @id @default(uuid())
  userId      String
  company     String
  role        String
  url         String?
  location    String?
  type        String   @default("remote")
  status      String   @default("wishlist")
  salaryMin   Int?
  salaryMax   Int?
  currency    String   @default("USD")
  appliedDate DateTime?
  notes       String?
  offerPayType      String?
  offerPayRate      String?
  offerSalary       Int?
  offerPayFrequency String?
  offerHoursPerWeek Float?
  offerOtHours      Float?
  offerOtRate       Float?   @default(1.5)
  offerSigningBonus Int?
  offerAnnualBonus  Int?
  offerEquity       String?
  offer401kMatch    Float?
  offerPtoDays      Int?
  offerHealthCost   Float?
  offerStartDate    DateTime?
  offerNotes        String?
  ein             String?
  resumeVersionId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  linkedEmails  Email[]
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
}

model Interview {
  id              String   @id @default(uuid())
  userId          String
  jobApplicationId String
  type            String   @default("phone")
  scheduledAt     DateTime
  durationMinutes Int?     @default(60)
  location        String?
  interviewerName String?
  interviewerRole String?
  notes           String?
  status          String   @default("scheduled")
  rating          Int?
  prepNotes       String?
  questions       String?
  reflection      String?
  reflectionRating Int?
  createdAt       DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
}

model Contact {
  id              String   @id @default(uuid())
  userId          String
  name            String
  email           String?
  phone           String?
  company         String?
  role            String?
  linkedinUrl     String?
  relationship    String   @default("other")
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecruiterSubmission {
  id             String   @id @default(uuid())
  userId         String
  recruiterName  String
  recruiterEmail String
  company        String?
  linkedinUrl    String?
  jobTitle       String
  jobDescription String?
  salaryMin      Int?
  salaryMax      Int?
  location       String?
  jobType        String?
  message        String?
  status         String   @default("new")
  contactId      String?
  applicationId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Skills & Learning ─────────────────────────────────────────

model Skill {
  id          String   @id @default(uuid())
  userId      String
  name        String
  category    String   @default("technical")
  proficiency String   @default("intermediate")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certification {
  id            String    @id @default(uuid())
  userId        String
  name          String
  issuer        String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialUrl String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningItem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  provider    String?
  type        String   @default("course")
  status      String   @default("not_started")
  progress    Int      @default(0)
  url         String?
  hoursSpent  Float    @default(0)
  cost        Float    @default(0)
  completedAt DateTime?
  skills      String?
  notes       String?
  tags        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Resume & Portfolio ────────────────────────────────────────

model ResumeVersion {
  id            String   @id @default(uuid())
  userId        String
  name          String
  filePath      String?
  fileName      String?
  fileSize      Int?
  targetRole    String?
  notes         String?
  versionNumber Int      @default(1)
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]
}

model InteractiveResume {
  id            String   @id @default(uuid())
  userId        String
  slug          String   @unique
  title         String
  targetRole    String?
  summary       String?
  theme         String   @default("modern")
  isPublished   Boolean  @default(false)
  sections      String?
  customContent String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  views ResumeView[]
}

model ResumeView {
  id              String            @id @default(uuid())
  resumeId        String
  referrer        String?
  userAgent       String?
  sectionsViewed  String?
  durationSeconds Int?
  createdAt       DateTime          @default(now())

  resume InteractiveResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

// ─── Profile & Identity ────────────────────────────────────────

model UserProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  fullName           String?
  headline           String?
  email              String?
  phone              String?
  avatarUrl          String?
  city               String?
  state              String?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  availability       String   @default("open_to_work")
  bio                String?
  preferredRoles     String?
  targetSalaryMin    Int?
  targetSalaryMax    Int?
  currency           String   @default("USD")
  locationPreference String?
  showSkills         Boolean  @default(true)
  showResume         Boolean  @default(true)
  showCertifications Boolean  @default(true)
  showCurrentRole    Boolean  @default(true)
  portalSlug         String   @default("portal") @unique
  filingStatus       String   @default("single")
  federalTaxRate     Float?
  stateTaxRate       Float?
  monthlyExpenses    String?

  // ── Stealth Mode / Privacy ──
  visibility         String   @default("public")   // public | stealth | anonymous | private
  hideCurrentEmployer Boolean @default(false)
  anonymousTitle     String?                        // e.g. "Verified Electro-Mechanical Specialist #842"
  blockedEins        String?                        // JSON array of EINs to block
  blockedDomains     String?                        // JSON array of email domains to block

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessRequests AccessRequest[]
  singleUseLinks SingleUseLink[]
}

// ─── Stealth Mode: Access Requests ─────────────────────────────

model AccessRequest {
  id            String    @id @default(uuid())
  profileId     String
  requesterName String
  requesterEmail String
  requesterCompany String?
  requesterLinkedin String?
  message       String?
  status        String    @default("pending")  // pending | approved | denied
  approvedAt    DateTime?
  accessToken   String?   @unique              // magic link token for approved access
  tokenExpiresAt DateTime?
  createdAt     DateTime  @default(now())

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Stealth Mode: Single-Use Links ────────────────────────────

model SingleUseLink {
  id          String    @id @default(uuid())
  profileId   String
  token       String    @unique
  label       String?                           // e.g. "For Recruiter at ABB"
  viewedAt    DateTime?
  viewedBy    String?                           // IP or user-agent of viewer
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Current Position & Work ───────────────────────────────────

model CurrentPosition {
  id            String    @id @default(uuid())
  userId        String
  company       String
  role          String
  department    String?
  location      String?
  type          String    @default("remote")
  startDate     DateTime
  endDate       DateTime?
  salary        Int?
  currency      String    @default("USD")
  description   String?
  responsibilities String?
  techStack     String?
  managerName   String?
  isActive      Boolean   @default(true)
  ein           String?
  legalName     String?
  companySynopsis String?
  industry      String?
  website       String?
  address       String?
  focus         String?
  schedule      String?
  payRate       String?
  payType       String    @default("salary")
  differentials String?
  payFrequency  String    @default("biweekly")
  rotatingSchedule Boolean @default(false)
  hoursPerWeek  Float?
  scheduleBHours Float?
  otHoursA      Float?
  otHoursB      Float?
  otRate        Float?    @default(1.5)
  annualRaiseMin Float?
  annualRaiseMax Float?
  estimatorSettings String?
  coverImage    String?   // base64 cover photo for job header card
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  compensation CompensationEvent[]
  benefits     Benefit[]
  timeOff      TimeOffBalance[]
  paychecks    PaycheckRecord[]
  equipment    Equipment[]
  workLogs     WorkLog[]
}

model Equipment {
  id            String    @id @default(uuid())
  positionId    String
  name          String
  category      String    @default("hardware")
  manufacturer  String?
  model         String?
  serialNumber  String?
  assetTag      String?
  assignedDate  DateTime?
  returnedDate  DateTime?
  condition     String    @default("good")
  licenseKey    String?
  version       String?
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  position  CurrentPosition   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  resources EquipmentResource[]
}

model EquipmentResource {
  id          String   @id @default(uuid())
  equipmentId String
  type        String   @default("manual")
  title       String
  content     String?
  fileName    String?
  fileData    Bytes?
  fileMime    String?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model WorkLog {
  id             String   @id @default(uuid())
  positionId     String
  date           DateTime
  title          String
  content        String?
  category       String   @default("task")
  hours          Float?
  tags           String?
  accomplishment Boolean  @default(false)
  impact         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  position CurrentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

// ─── Compensation & Benefits ───────────────────────────────────

model CompensationEvent {
  id            String   @id @default(uuid())
  positionId    String
  type          String   @default("base_salary")
  title         String
  amount        Int
  currency      String   @default("USD")
  effectiveDate DateTime
  recurring     Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  position CurrentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model Benefit {
  id           String    @id @default(uuid())
  positionId   String
  category     String    @default("health")
  name         String
  provider     String?
  coverage     String?
  employerCost Int?
  employeeCost Int?
  notes        String?
  enrolledAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  position CurrentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model TimeOffBalance {
  id        String   @id @default(uuid())
  positionId String
  category  String   @default("pto")
  totalDays Float    @default(0)
  usedDays  Float    @default(0)
  year      Int
  accrual   String   @default("annual")
  carryOver Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())

  entries  TimeOffEntry[]
  position CurrentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model TimeOffEntry {
  id        String   @id @default(uuid())
  balanceId String
  startDate DateTime
  endDate   DateTime
  days      Float    @default(1)
  status    String   @default("planned")
  reason    String?
  createdAt DateTime @default(now())

  balance TimeOffBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)
}

model PaycheckRecord {
  id              String    @id @default(uuid())
  positionId      String
  payPeriodStart  DateTime?
  payPeriodEnd    DateTime?
  grossPay        Float?
  netPay          Float?
  payRate         Float?
  regularHours    Float?
  overtimeHours   Float?
  ytdGross        Float?
  ytdNet          Float?
  ytdFederalTax   Float?
  ytdStateTax     Float?
  ytdSocialSec    Float?
  ytdMedicare     Float?
  ytdRetirement   Float?
  ytdHealthIns    Float?
  ytdTotalDed     Float?
  taxPercentages  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  position CurrentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

// ─── Career Goals & Planning ───────────────────────────────────

model CareerGoal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  targetDate  DateTime?
  status      String   @default("not_started")
  priority    String   @default("medium")
  createdAt   DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]
}

model Milestone {
  id           String    @id @default(uuid())
  careerGoalId String
  title        String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  careerGoal CareerGoal @relation(fields: [careerGoalId], references: [id], onDelete: Cascade)
}

model CareerPath {
  id              String   @id @default(uuid())
  userId          String
  title           String
  description     String?
  targetRole      String?
  targetSalaryMin Int?
  targetSalaryMax Int?
  industry        String?
  level           String   @default("mid")
  requiredSkills  String?
  timelineYears   Int?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones CareerPathMilestone[]
  scores     DirectionScore[]
}

model CareerPathMilestone {
  id          String  @id @default(uuid())
  pathId      String
  title       String
  description String?
  sortOrder   Int     @default(0)
  isRequired  Boolean @default(false)

  path CareerPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
}

model CareerSnapshot {
  id               String   @id @default(uuid())
  userId           String
  capturedAt       DateTime @default(now())
  totalSkills      Int      @default(0)
  avgProficiency   Float    @default(0)
  incomeGross      Float?
  incomeNet        Float?
  activeGoals      Int      @default(0)
  completedGoals   Int      @default(0)
  certCount        Int      @default(0)
  applicationsOpen Int      @default(0)
  interviewsCount  Int      @default(0)
  currentRole      String?
  currentCompany   String?
  overallScore     Float?
  metadata         String?

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores DirectionScore[]
}

model DirectionScore {
  id              String   @id @default(uuid())
  snapshotId      String
  pathId          String
  skillMatch      Float    @default(0)
  incomeAlignment Float    @default(0)
  goalAlignment   Float    @default(0)
  overallScore    Float    @default(0)
  gaps            String?
  createdAt       DateTime @default(now())

  snapshot CareerSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  path     CareerPath     @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, pathId])
}

// ─── Financial & Tax ───────────────────────────────────────────

model CareerIncomeYear {
  id          String   @id @default(uuid())
  userId      String
  year        Int
  grossIncome Float
  netIncome   Float?
  jobCount    Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries  CareerIncomeEntry[]
  w2Records W2Record[]

  @@unique([userId, year])
}

model CareerIncomeEntry {
  id          String   @id @default(uuid())
  yearId      String
  employer    String
  grossIncome Float
  netIncome   Float?
  ein         String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  incomeYear CareerIncomeYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model W2Record {
  id                  String   @id @default(uuid())
  yearId              String
  taxYear             Int
  employerName        String?
  employerEIN         String?
  employerAddress     String?
  state               String?
  wages               Float?
  federalTaxWithheld  Float?
  socialSecurityWages Float?
  socialSecurityTax   Float?
  medicareWages       Float?
  medicareTax         Float?
  stateWages          Float?
  stateTaxWithheld    Float?
  localWages          Float?
  localTaxWithheld    Float?
  netIncome           Float?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  incomeYear CareerIncomeYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model WageTier {
  id         String   @id @default(uuid())
  userId     String
  label      String
  hourlyRate Float
  yearlyRate Float
  sortOrder  Int      @default(0)
  color      String   @default("#6366f1")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Email Integration ─────────────────────────────────────────

model EmailAccount {
  id           String    @id @default(uuid())
  userId       String
  provider     String
  email        String
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@unique([userId, provider, email])
}

model Email {
  id         String   @id @default(uuid())
  accountId  String
  messageId  String
  subject    String?
  sender     String
  recipient  String?
  date       DateTime
  snippet    String?
  body       String?
  isRead     Boolean  @default(false)
  labels     String?
  applicationId String?
  createdAt  DateTime @default(now())

  account    EmailAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  application JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([accountId, messageId])
}

// ─── Utility & Tracking ────────────────────────────────────────

model Reminder {
  id         String   @id @default(uuid())
  userId     String
  entityType String
  entityId   String
  title      String
  remindAt   DateTime
  isDismissed Boolean @default(false)
  snoozedUntil DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  entityType  String
  entityId    String
  action      String
  description String
  metadata    String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id         String   @id @default(uuid())
  userId     String
  name       String
  fileName   String
  fileSize   Int
  mimeType   String
  data       String
  category   String   @default("other")
  entityType String?
  entityId   String?
  notes      String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Research & Market Data ────────────────────────────────────

model ResearchFeed {
  id            String   @id @default(cuid())
  userId        String
  title         String
  url           String
  category      String   @default("general")
  isActive      Boolean  @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  articles ResearchArticle[]

  @@unique([userId, url])
}

model ResearchArticle {
  id          String   @id @default(cuid())
  feedId      String
  title       String
  url         String
  source      String?
  summary     String?
  content     String?
  publishedAt DateTime?
  imageUrl    String?
  isBookmarked Boolean  @default(false)
  isRead      Boolean  @default(false)
  tags        String?
  createdAt   DateTime @default(now())

  feed ResearchFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
}

model MarketSearch {
  id            String   @id @default(cuid())
  userId        String
  seriesId      String
  title         String
  occupation    String?
  area          String?
  dataType      String   @default("wages")
  lastData      String?
  lastFetchedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyProfile {
  id              String    @id @default(uuid())
  userId          String
  ein             String
  name            String?
  address         String?
  state           String?
  industry        String?
  naicsCode       String?
  website         String?
  employeeCount   Int?
  isPublic        Boolean   @default(false)
  secCIK          String?
  form5500Data    String?
  oshaData        String?
  secData         String?
  sosData         String?
  researchNotes   String?
  lastFetchedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ein])
}

// ─── Site-Level Market Data Cache ──────────────────────────────

model SiteMarketData {
  id              String   @id @default(cuid())
  occupation      String
  socCode         String
  region          String   @default("national")
  experienceLevel String   @default("all")
  periodLabel     String   // e.g. "2026-Q1"
  median          Int?
  mean            Int?
  p10             Int?
  p25             Int?
  p75             Int?
  p90             Int?
  low             Int?
  high            Int?
  rawAnswer       String?  // AI summary text
  sourcesJson     String?  // JSON array of {title,url,snippet}
  fetchedAt       DateTime @default(now())
  staleAfter      DateTime // fetchedAt + staleness window

  @@unique([socCode, region, experienceLevel, periodLabel])
  @@index([socCode, region])
}

// ─── Site-Level Video Feed Cache ───────────────────────────────

model SiteVideoFeed {
  id          String   @id @default(cuid())
  searchQuery String   @unique          // normalized query string
  category    String   @default("general") // industry, skills, tools, equipment, career
  videosJson  String                     // JSON array of video objects
  fetchedAt   DateTime @default(now())
  staleAfter  DateTime                   // fetchedAt + staleness window
}

// ─── Micro-Learning ────────────────────────────────────────────

model LearningTopic {
  id          String   @id @default(uuid())
  userId      String
  documentId  String?
  title       String
  summary     String
  content     String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  sessions  StudySession[]
}

model QuizQuestion {
  id           String  @id @default(uuid())
  topicId      String
  question     String
  type         String  @default("multiple_choice") // multiple_choice, true_false
  optionsJson  String  // JSON array of option strings
  answer       String
  explanation  String?

  topic LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model StudySession {
  id          String   @id @default(uuid())
  userId      String
  topicId     String
  score       Int      @default(0)
  totalQs     Int      @default(0)
  completedAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

// ─── Interest Groups (job research/comparison) ──────────────────

model InterestGroup {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#6366f1") // indigo default
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items InterestGroupItem[]

  @@unique([userId, name])
}

model InterestGroupItem {
  id           String   @id @default(uuid())
  groupId      String
  userId       String
  jobKey       String   // deterministic key like "google-xxx" or "adzuna-xxx"
  title        String
  company      String
  location     String?
  url          String?
  salaryMin    Int?
  salaryMax    Int?
  source       String   // "adzuna" | "google"
  description  String?
  thumbnail    String?
  scheduleType String?
  createdAt    DateTime @default(now())

  group InterestGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, jobKey])
}

// ─── Life Anchors (Job Search) ──────────────────────────────────

model LifeAnchor {
  id        String   @id @default(uuid())
  userId    String
  label     String   // e.g. "Home", "Spouse's Work", "Kids' School"
  icon      String   @default("home") // lucide icon name
  address   String
  lat       Float
  lng       Float
  weight    Int      @default(3) // priority 1-5
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Company Job Postings ──────────────────────────────────────

model JobPosting {
  id              String    @id @default(uuid())
  userId          String?
  slug            String    @unique @default(uuid())
  company         String
  companyLogo     String?
  role            String
  department      String?
  location        String?
  type            String    @default("remote")  // remote, hybrid, onsite
  employmentType  String    @default("full_time") // full_time, part_time, contract, internship, temporary
  experienceLevel String    @default("mid")     // entry, mid, senior, lead, executive
  salaryMin       Int?
  salaryMax       Int?
  currency        String    @default("USD")
  payFrequency    String    @default("yearly")  // hourly, yearly
  description     String
  requirements    String?
  niceToHave      String?
  benefits        String?
  techStack       String?                        // comma-separated
  applicationUrl  String?                        // external link or null for in-app
  contactEmail    String?
  ein             String?
  isPublished     Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  expiresAt       DateTime?
  viewCount       Int       @default(0)
  applicationCount Int      @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isPublished, createdAt])
  @@index([company])
  @@index([type, experienceLevel])
}
