  provider     String?
  coverage     String?
  employerCost Int?
  employeeCost Int?
  notes        String?
  enrolledAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  position WorkHistory @relation("WorkHistoryBenefits", fields: [positionId], references: [id], onDelete: Cascade)
