# Resumsify — environment variable template.
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Do NOT commit `.env`. Do NOT paste real secrets in this template.

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/resumsify"

# ─── Auth (NextAuth v5) ──────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# ─── Google OAuth (sign-in) ──────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Microsoft OAuth (sign-in, optional) ─────────────────────
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ─── App URL (used for OAuth redirects) ──────────────────────
APP_URL="http://localhost:3000"

# ─── External Import Integrations (Sprint 6 — Notion / OneDrive) ──
# AES-256-GCM master key for encrypting OAuth access tokens at rest.
# Generate fresh: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_TOKEN_KEY=""

# Notion OAuth (Sprint 6A) — create a public integration at:
#   https://www.notion.so/profile/integrations
# then paste the client id + secret here. Redirect URI MUST match what you
# register in Notion exactly.
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
NOTION_REDIRECT_URI="http://localhost:3000/api/integrations/notion/oauth/callback"

# Set to "1" to render the Connect Notion card on /integrations.
# Leave at "0" until NOTION_CLIENT_ID is filled in.
NEXT_PUBLIC_NOTION_OAUTH_ENABLED="0"

# ─── Misc external API keys (fill only the ones you use) ─────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash-lite"
SERPAPI_KEY=""
TAVILY_API_KEY=""
YOUTUBE_API_KEY=""
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
EIA_API_KEY=""
ORS_API_KEY=""
USAJOBS_API_KEY=""
USAJOBS_EMAIL=""
WALKSCORE_API_KEY=""
BLS_API_KEY=""
ONET_API_KEY=""
