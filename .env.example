PORT=3000
DATABASE_PATH=data/proforna.sqlite
UPLOADS_DIR=data/uploads

# Gmail job mail. Create an OAuth client (Web application) and leave these empty
# until that client exists. Proforna asks only for
# https://www.googleapis.com/auth/gmail.readonly
# Authorized redirect URI: http://localhost:3000/api/mailbox/gmail/callback
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/mailbox/gmail/callback
# Where the browser returns after Google signs the occupant in.
# PROFORNA_APP_ORIGIN=http://localhost:5173
# Optional stand-in for the Google hosts. Leave unset to use Google.
# GMAIL_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GMAIL_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# GMAIL_API_BASE=https://gmail.googleapis.com
