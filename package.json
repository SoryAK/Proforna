{
  "name": "proforna",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:app": "cd web && tauri dev",
    "package:app": "cd web && tauri build --config src-tauri/tauri.package.json",
    "dev:relay": "tsx watch relay/index.ts",
    "prototype:agentic": "vite --config web/vite.config.ts --host 0.0.0.0 --port 4174",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "start:relay": "tsx relay/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.13",
    "@astryxdesign/richtext": "0.7.13",
    "@astryxdesign/theme-neutral": "^0.7.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@heroicons/react": "2.2.0",
    "@hono/node-server": "^2.1.1",
    "@lexical/code": "0.52.0",
    "@lexical/extension": "0.52.0",
    "@lexical/headless": "0.52.0",
    "@lexical/html": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/table": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@stylexjs/stylex": "^0.19.1",
    "docx": "^9.7.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.8",
    "leaflet": "^1.9.4",
    "lexical": "0.52.0",
    "lucide-react": "1.66.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.13",
    "@tauri-apps/cli": "^2.11.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
