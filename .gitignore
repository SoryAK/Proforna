# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Prisma
*.db
*.db-journal

# Local-only smoke-test fixtures (ad-hoc files used during manual QA)
.smoke/

# CodeGraph (local index — junctioned to C:\CodeGraphCache\resumsify to bypass OneDrive)
.codegraph/
# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/

# Local AI tooling configs (per-machine; rules duplicated in .github/copilot-instructions.md)
.clinerules
.continue/

# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Understand-Anything (keep knowledge-graph.json, skip local scratch files)
.understand-anything/intermediate/
.understand-anything/diff-overlay.json

# Chat conversation exports (local-only, for workflow review).
# Ignore contents, not the directories themselves, so we can re-include
# specific files. The workflow-change-log is the canonical source of
# truth for cohort attribution and must be tracked in git (ADR-0036
# Decision 6).
docs/chat-exports/*
!docs/chat-exports/analysis/
docs/chat-exports/analysis/*
!docs/chat-exports/analysis/workflow-change-log.json

# Shipyard mined-traversal candidates (ADR-0038) — staging artifacts
# regenerated by `node scripts/analyze-chat-exports.mjs --mine-traversals <slice>`.
# Promoted candidates land in the slice JSON itself, which IS tracked.
docs/c-yard/_candidates/

# Throwaway diagnostic capture files from review/lint/test pipelines (T1-T3 cleanup)
scripts/_*

# Column 2 semantic-review runtime logs (ad-hoc Tee-Object output during audit
# runs). The JSON output files in this directory ARE tracked — they are the
# audit results referenced by ADR-0047.
docs/review-semantic/_*.log
